{% extends "base.html.j2" %}
{% set sample = ctx.sample %}
{% set m = ctx.hsmetrics.metrics if ctx.hsmetrics else {} %}

{% block title %}{{ sample }} — Targeted-Seq Report{% endblock %}

{% block body %}
<div class="d-flex">

  {# ---------- LEFT SIDEBAR ---------- #}
  <nav class="tspipe-sidebar">
    <div class="mb-3">
      <a href="{{ cohort_link | default('../cohort_index.html') }}" class="text-decoration-none text-secondary small">
        &laquo; Back to cohort
      </a>
    </div>
    <h6 class="text-uppercase text-muted small mb-1">Sample</h6>
    <div class="fw-semibold mb-3" style="word-break: break-all;">{{ sample }}</div>

    <ul class="nav nav-pills flex-column" id="sample-tabs" role="tablist">
      <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-overview"  type="button" role="tab">Overview</button></li>
      <li class="nav-item"><button class="nav-link"        data-bs-toggle="pill" data-bs-target="#tab-qc"        type="button" role="tab">QC</button></li>
      <li class="nav-item"><button class="nav-link"        data-bs-toggle="pill" data-bs-target="#tab-clinical"  type="button" role="tab">Variants &mdash; Clinical</button></li>
      <li class="nav-item"><button class="nav-link"        data-bs-toggle="pill" data-bs-target="#tab-filtered"  type="button" role="tab">Variants &mdash; All Filtered</button></li>
      {# DASH_BLACKLIST_V1 (D16) #}
      {% set _bl_rows = (ctx.filtered.rows if ctx.filtered and ctx.filtered.rows else []) | selectattr('Filter', 'equalto', 'BLACKLIST') | list %}
      {% set _bl_supported = _bl_rows | selectattr('VariantCaller_Count', 'ne', '-1') | selectattr('VariantCaller_Count', 'ne', '1') | selectattr('VariantCaller_Count', 'ne', '0') | list %}
      <li class="nav-item"><button class="nav-link"        data-bs-toggle="pill" data-bs-target="#tab-blacklist" type="button" role="tab">Blacklisted <span class="badge bg-secondary ms-1">{{ _bl_supported | length }}</span></button></li>
      {# SPIKEIN_V1 (D13) #}
      {% if ctx.spikein %}
      <li class="nav-item"><button class="nav-link"        data-bs-toggle="pill" data-bs-target="#tab-spikein" type="button" role="tab">Spike-in <span class="badge bg-secondary ms-1">{{ ctx.spikein.n_variants }}</span></button></li>
      {% endif %}
      <li class="nav-item"><button class="nav-link"        data-bs-toggle="pill" data-bs-target="#tab-flt3"      type="button" role="tab">FLT3</button></li>
      <li class="nav-item"><button class="nav-link"        data-bs-toggle="pill" data-bs-target="#tab-cnv"       type="button" role="tab">CNV</button></li>
      <li class="nav-item"><button class="nav-link"        data-bs-toggle="pill" data-bs-target="#tab-igv"       type="button" role="tab">IGV</button></li>
      <li class="nav-item"><button class="nav-link"        data-bs-toggle="pill" data-bs-target="#tab-reporting" type="button" role="tab">Reporting <span id="reporting-count-badge" class="badge bg-secondary ms-1" style="display:none">0</span></button></li>
      <li class="nav-item"><button class="nav-link"        data-bs-toggle="pill" data-bs-target="#tab-files"     type="button" role="tab">Files</button></li>
    </ul>

    <div class="tspipe-footer small">
      Generated {{ ctx.build_time }}<br>
      Builder v{{ ctx.builder_version }}
    </div>
  </nav>

  {# ---------- MAIN PANEL ---------- #}
  <main class="tspipe-main flex-grow-1">
    <div class="tab-content">

      {# ===== Overview tab ===== #}
      <div class="tab-pane fade show active" id="tab-overview" role="tabpanel">
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
          <h3 class="mb-0">{{ sample }}</h3>
          {# DASH_QC_V1: verdict pill #}
          {% if ctx.qc_verdict %}
            <span class="badge fs-6 {{ ctx.qc_verdict.pill }}">{{ ctx.qc_verdict.label }}</span>
          {% else %}
            <span class="badge fs-6 qc-pill-pending">QC not available</span>
          {% endif %}
        </div>

        <div class="row g-3 mb-4">
          <div class="col-md-3">
            <div class="tspipe-summary-card">
              <div class="label">Median Coverage</div>
              {% if ctx.coverage and ctx.coverage.summary %}
                <div class="value">{{ ctx.coverage.summary.median_of_per_exon | format_num(0) }}x</div>
                <div class="subvalue">median of {{ ctx.coverage.summary.n_exons }} per-exon coverages &middot; duplicates included</div>
              {% else %}
                <div class="value">&mdash;</div>
                <div class="subvalue">per-exon coverage not available</div>
              {% endif %}
            </div>
          </div>
          <div class="col-md-3">
            <div class="tspipe-summary-card">
              <div class="label">Low-Coverage Genes</div>
              {% if ctx.coverage and ctx.coverage.summary %}
                <div class="value">{{ ctx.coverage.summary.n_low_genes }}</div>
                <div class="subvalue">median exon coverage below {{ ctx.coverage.thresholds.gene_low_median }}x &middot; {{ ctx.coverage.summary.n_low_lt_100 }} exons below 100x</div>
              {% else %}
                <div class="value">&mdash;</div>
              {% endif %}
            </div>
          </div>
          <div class="col-md-3">
            <div class="tspipe-summary-card">
              {# DASH_QC_V1e: reportability tier #}
              <div class="label">% Regions &ge; {{ ctx.coverage.thresholds.exon_reportable if ctx.coverage else 200 }}x</div>
              {% if ctx.coverage and ctx.coverage.summary %}
                <div class="value">{{ (ctx.coverage.summary.pct_exons_ge_200 * 100) | format_num(1) }}%</div>
                <div class="subvalue">{{ ctx.coverage.summary.n_exons_ge_200 }} of {{ ctx.coverage.summary.n_exons }} exons &middot; {{ ctx.coverage.regions_below_reportable | length }} below &middot; mosdepth, duplicates included</div>
              {% else %}
                <div class="value">&mdash;</div>
              {% endif %}
            </div>
          </div>
          <div class="col-md-3">
            <div class="tspipe-summary-card">
              <div class="label">Fold-80 Penalty</div>
              <div class="value">{{ m.FOLD_80_BASE_PENALTY | format_num(2) if m.FOLD_80_BASE_PENALTY is defined and m.FOLD_80_BASE_PENALTY is not none else '—' }}</div>
              <div class="subvalue">Uniformity</div>
            </div>
          </div>

          <div class="col-md-3">
            <div class="tspipe-summary-card">
              <div class="label">AT Dropout</div>
              <div class="value">{{ m.AT_DROPOUT | format_num(2) if m.AT_DROPOUT is defined and m.AT_DROPOUT is not none else '—' }}</div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="tspipe-summary-card">
              <div class="label">GC Dropout</div>
              <div class="value">{{ m.GC_DROPOUT | format_num(2) if m.GC_DROPOUT is defined and m.GC_DROPOUT is not none else '—' }}</div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="tspipe-summary-card">
              <div class="label">Clinical Variants</div>
              <div class="value">{{ ctx.clinical.n if ctx.clinical else '—' }}</div>
              <div class="subvalue">{{ ctx.clinical.n_pass if ctx.clinical else '—' }} PASS</div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="tspipe-summary-card">
              <div class="label">FLT3-ITD</div>
              <div class="value">
                {% if ctx.flt3 and ctx.flt3.n_positive > 0 -%}
                  Detected
                {%- elif ctx.flt3 -%}
                  Not detected
                {%- else -%}
                  &mdash;
                {%- endif %}
              </div>
              <div class="subvalue">
                {% if ctx.flt3 and ctx.flt3.n_positive > 0 %}{{ ctx.flt3.n_positive }} event(s){% endif %}
              </div>
            </div>
          </div>
        </div>

        {# DASH_QC_V1: verdict reasons and the complete low-coverage gene list #}
        {% if ctx.qc_verdict and ctx.qc_verdict.reasons %}
          <div class="alert alert-light border" role="alert">
            <strong>{{ ctx.qc_verdict.label }}.</strong>
            {% for r in ctx.qc_verdict.reasons %}<div>{{ r }}</div>{% endfor %}
          </div>
        {% endif %}
        {% if ctx.coverage and ctx.coverage.low_genes %}
          <div class="alert alert-light border" role="alert">
            <strong>Low-coverage genes (median exon coverage &lt; {{ ctx.coverage.thresholds.gene_low_median }}x), lowest first:</strong>
            {% for g in ctx.coverage.low_genes %}
              <span class="badge bg-light text-dark border me-1">{{ g.gene }} &middot; {{ g.median_cov | format_num(0) }}x{% if g.driver_role %} &middot; {{ g.driver_role }}{% endif %}{% if g.cnv_call %} &middot; CNV {{ g.cnv_call }} {{ g.cnv_tier }}{% endif %}</span>   {# DASH_QC_V1b #}
            {% endfor %}
            <div class="small text-muted mt-1">Full detail on the QC tab.</div>
          </div>
        {% endif %}
        {# DASH_QC_V1d: known panel limitations, one line #}
        {% if ctx.coverage and ctx.coverage.panel_limitations %}
          <div class="alert alert-light border small" role="alert">
            <strong>Known panel limitations</strong> (under-captured in the normal cohort; not counted against this sample):
            {% for r in ctx.coverage.panel_limitations %}<span class="badge bg-light text-dark border me-1">{{ r.gene }} {{ r.exon }} &middot; {{ r.sample_cov | format_num(0) }}x</span>{% endfor %}
          </div>
        {% endif %}
      </div>

      {# ===== QC tab ===== #}
      <div class="tab-pane fade" id="tab-qc" role="tabpanel">

        {# DASH_QC_V1: QC tab -- verdict | low-coverage genes | run metrics | per-gene chart | all genes | fastp | per-exon #}
        <h4>Verdict</h4>
        {% if ctx.qc_verdict %}
          <p class="mb-1"><span class="badge fs-6 {{ ctx.qc_verdict.pill }}">{{ ctx.qc_verdict.label }}</span></p>
          {% if ctx.qc_verdict.reasons %}
            <ul class="small mb-2">{% for r in ctx.qc_verdict.reasons %}<li>{{ r }}</li>{% endfor %}</ul>
          {% else %}
            <p class="small text-muted mb-2">All run-level metrics within limits; every gene at or above {{ ctx.coverage.thresholds.gene_low_median if ctx.coverage else 100 }}x median exon coverage.</p>
          {% endif %}
          <p class="small text-muted mb-3">REVIEW: a run-level metric is outside its limit. PASS WITH LIMITATIONS: run-level metrics acceptable but one or more genes fall below the gene threshold; negative results in those genes are not reportable without review. PASS: no limitation.</p>
        {% else %}
          <div class="tspipe-empty">Verdict not available (coverage or HsMetrics missing).</div>
        {% endif %}

        {# DASH_QC_V2: sample identity #}
        <h4 class="mt-4">Sample identity (sex check)</h4>
        {% if ctx.qc_verdict and ctx.qc_verdict.identity %}
          <p class="text-muted small mb-2">Sex is decided by chrX heterozygosity at the het catalog (males near 0, females near the autosomal fraction); X/autosome depth confirms it or flags a chrX copy-number change. A samplesheet sex that contradicts heterozygosity is a possible sample swap and sets REVIEW.</p>
          <table class="table table-sm tspipe-kv-table" style="max-width: 760px;"><tbody>
            {% for k, v in ctx.qc_verdict.identity %}<tr><td class="label">{{ k }}</td><td class="value">{{ v }}</td></tr>{% endfor %}
          </tbody></table>
        {% else %}
          <div class="tspipe-empty">Sex check not available.</div>
        {% endif %}

        <h4 class="mt-4">Low-coverage genes</h4>
        {% if ctx.coverage and ctx.coverage.low_genes %}
          <p class="text-muted small mb-2">Every gene whose median exon coverage is below {{ ctx.coverage.thresholds.gene_low_median }}x, lowest first. Coverage is mosdepth per-exon mean with duplicates included; the gene value is the median across its exons. A gene with a consensus LOSS in the CNV tab is low because it is deleted, and is not counted as a limitation.</p>
          <div class="table-responsive">
            <table id="qc-low-genes-table" class="table table-sm table-striped table-hover w-100">
              <thead><tr><th>gene</th><th>driver role</th><th>median exon cov</th><th>worst exon</th><th>worst exon cov</th><th>exons &lt; {{ ctx.coverage.thresholds.exon_low }}x</th><th>n exons</th><th>CNV consensus</th></tr></thead>
              <tbody>
                {% for g in ctx.coverage.low_genes %}
                  <tr><td>{{ g.gene }}</td><td>{{ g.driver_role }}</td><td>{{ g.median_cov | format_num(0) }}</td><td>{{ g.min_exon }}</td><td>{{ g.min_cov | format_num(0) }}</td><td>{{ g.n_low }} ({{ (g.frac_low * 100) | format_num(0) }}%)</td><td>{{ g.n_exons }}</td><td>{% if g.cnv_call %}{{ g.cnv_call }} {{ g.cnv_tier }}{% endif %}</td></tr>   {# DASH_QC_V1b #}
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% elif ctx.coverage and ctx.coverage.summary %}
          <p class="text-muted small">No gene below {{ ctx.coverage.thresholds.gene_low_median }}x median exon coverage.</p>
        {% else %}
          <div class="tspipe-empty">Per-exon coverage file not available.</div>
        {% endif %}

        {# DASH_QC_V1e: every region under the reportability tier #}
        <h4 class="mt-4">Regions below {{ ctx.coverage.thresholds.exon_reportable if ctx.coverage else 200 }}x</h4>
        {% if ctx.coverage and ctx.coverage.regions_below_reportable %}
          <p class="text-muted small mb-2">{{ ctx.coverage.summary.n_exons_ge_200 }} of {{ ctx.coverage.summary.n_exons }} regions ({{ (ctx.coverage.summary.pct_exons_ge_200 * 100) | format_num(1) }}%) are at or above {{ ctx.coverage.thresholds.exon_reportable }}x. The rest are listed here, lowest first: below {{ ctx.coverage.thresholds.exon_low }}x the region is low; between {{ ctx.coverage.thresholds.exon_low }}x and {{ ctx.coverage.thresholds.exon_reportable }}x it is covered but under the reportability tier. Known panel limitations are marked.</p>
          <div class="table-responsive">
            <table id="qc-regions-table" class="table table-sm table-striped table-hover w-100">
              <thead><tr><th>gene</th><th>exon</th><th>coverage</th><th>band</th><th>driver role</th><th>known limitation</th><th>CNV consensus</th></tr></thead>
              <tbody>
                {% for r in ctx.coverage.regions_below_reportable %}
                  <tr class="{% if r.band.startswith('<') %}table-danger{% endif %}"><td>{{ r.gene }}</td><td>{{ r.exon }}</td><td>{{ r.cov | format_num(0) }}</td><td>{{ r.band }}</td><td>{{ r.driver_role }}</td><td>{% if r.known %}yes{% endif %}</td><td>{{ r.cnv_call }}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% elif ctx.coverage and ctx.coverage.summary %}
          <p class="text-muted small">All {{ ctx.coverage.summary.n_exons }} regions at or above {{ ctx.coverage.thresholds.exon_reportable }}x.</p>
        {% endif %}

        {# DASH_QC_V1d: known panel limitations with cohort statistics #}
        {% if ctx.coverage and ctx.coverage.panel_limitations %}
          <h4 class="mt-4">Known panel limitations</h4>
          <p class="text-muted small mb-2">Exons below {{ ctx.coverage.thresholds.exon_low }}x in at least half of the panel-of-normals cohort (assets/known_low_exons.tsv). They are a property of the capture design, are excluded from this sample's verdict, and variants in them are not reportable as negative.</p>
          <table class="table table-sm tspipe-kv-table" style="max-width: 760px;">
            <thead><tr><th>gene</th><th>exon</th><th>this sample</th><th>normals median</th><th>normals below threshold</th></tr></thead>
            <tbody>
              {% for r in ctx.coverage.panel_limitations %}
                <tr><td>{{ r.gene }}</td><td>{{ r.exon }}</td><td class="value">{{ r.sample_cov | format_num(0) }}x</td><td class="value">{{ r.normals_median | format_num(0) }}x</td><td class="value">{{ r.n_below }} / {{ r.n_normals }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        {% endif %}

        <h4 class="mt-4">Run metrics (Picard CollectHsMetrics)</h4>
        <p class="text-muted small mb-2">MAPQ &ge; 20, baseQ &ge; 20, overlap-clipped, duplicates excluded; these are lower than the duplicate-inclusive mosdepth coverages above. A limit is shown only for metrics that feed the verdict.</p>
        {% if ctx.qc_verdict and ctx.qc_verdict.run_metrics %}
          <table class="table table-sm tspipe-kv-table" style="max-width: 760px;">
            <thead><tr><th>metric</th><th>value</th><th>limit</th><th></th></tr></thead>
            <tbody>
              {% for r in ctx.qc_verdict.run_metrics %}
                <tr><td class="label">{{ r.label }}</td><td class="value">{{ r.display }}</td><td class="value">{{ r.range }}</td>
                    <td>{% if r.ok is true %}<span class="badge qc-pill-pass">ok</span>{% elif r.ok is false %}<span class="badge qc-pill-fail">out of limit</span>{% endif %}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <div class="tspipe-empty">HsMetrics file not available for this sample.</div>
        {% endif %}

        <h4 class="mt-4">Per-gene median coverage</h4>
        {% if ctx.coverage and ctx.coverage.genes %}
          <p class="text-muted small mb-2">Median exon coverage per gene, lowest first; dashed line at {{ ctx.coverage.thresholds.gene_low_median }}x; red bars are below it. Log scale.</p>
          <div style="position: relative; height: 320px;"><canvas id="qc-gene-chart"></canvas></div>
          <script>window.QC_GENES = {{ ctx.coverage.genes | tojson }}; window.QC_GENE_LOW = {{ ctx.coverage.thresholds.gene_low_median }};</script>

          <h4 class="mt-4">All genes</h4>
          <div class="table-responsive">
            <table id="qc-gene-table" class="table table-sm table-striped table-hover w-100">
              <thead><tr><th>gene</th><th>driver role</th><th>median exon cov</th><th>worst exon</th><th>worst exon cov</th><th>exons &lt; {{ ctx.coverage.thresholds.exon_low }}x</th><th>n exons</th><th>CNV consensus</th></tr></thead>
              <tbody>
                {% for g in ctx.coverage.genes %}
                  <tr><td>{{ g.gene }}</td><td>{{ g.driver_role }}</td><td>{{ g.median_cov | format_num(0) }}</td><td>{{ g.min_exon }}</td><td>{{ g.min_cov | format_num(0) }}</td><td>{{ g.n_low }}</td><td>{{ g.n_exons }}</td><td>{% if g.cnv_call %}{{ g.cnv_call }} {{ g.cnv_tier }}{% endif %}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}

        {# DASH_QC_V2: read-level QC table replaces the fastp iframe #}
        <h4 class="mt-4">Read-level QC (fastp)</h4>
        {% if ctx.qc_verdict and ctx.qc_verdict.read_metrics %}
          <p class="text-muted small mb-2">From fastp on the raw FASTQs, before alignment. Adapter trimming on a third of reads is expected with ~160 bp inserts on 150 bp reads. Limits are shown only for metrics that feed the verdict.</p>
          <table class="table table-sm tspipe-kv-table" style="max-width: 760px;">
            <thead><tr><th>metric</th><th>value</th><th>limit</th><th></th></tr></thead>
            <tbody>
              {% for r in ctx.qc_verdict.read_metrics %}
                <tr><td class="label">{{ r.label }}</td><td class="value">{{ r.display }}</td><td class="value">{{ r.range }}</td>
                    <td>{% if r.ok is true %}<span class="badge qc-pill-pass">ok</span>{% elif r.ok is false %}<span class="badge qc-pill-fail">out of limit</span>{% endif %}</td></tr>
              {% endfor %}
            </tbody>
          </table>
          {% if ctx.files.fastp %}<p class="small text-muted">Full fastp report (per-base quality, GC content, k-mer plots): <a href="./{{ ctx.files.fastp }}" target="_blank">{{ ctx.files.fastp }}</a></p>{% endif %}
        {% elif ctx.files.fastp %}
          <div class="tspipe-empty">fastp metrics not available (no <code>_fastp.json</code> in clinical/); full report: <a href="./{{ ctx.files.fastp }}" target="_blank">{{ ctx.files.fastp }}</a></div>
        {% else %}
          <div class="tspipe-empty">fastp output not available.</div>
        {% endif %}

        <details class="mt-4">
          <summary><h4 class="d-inline">Per-exon coverage</h4> <span class="text-muted small">(all exons; expand)</span></summary>
          {% if ctx.coverage and ctx.coverage.rows %}
            {{ macros.render_datatable('coverage-table', ctx.coverage.columns, ctx.coverage.rows) }}
          {% else %}
            <div class="tspipe-empty">Per-exon coverage file not available.</div>
          {% endif %}
        </details>
        {# DASH_QC_V1e: legacy per-sample dashboard no longer referenced #}
      </div>

      {# ===== Variants — Clinical tab ===== #}
      <div class="tab-pane fade" id="tab-clinical" role="tabpanel">
        <h4>Clinical variants</h4>
        <p class="text-muted small mb-3">
          Curated set from <code>somaticseq_clinical_final.tsv</code>. Use the filter
          panel on the left to narrow the list; click a variant to see full details
          and jump to its IGV view.
        </p>
        {% if ctx.clinical and ctx.clinical.rows %}
          <div id="clinical-browser"></div>
        {% else %}
          <div class="tspipe-empty">No clinical variants file found.</div>
        {% endif %}
      </div>

      {# ===== Variants — All Filtered tab ===== #}
      {# ===== Blacklisted tab (DASH_BLACKLIST_V1, D16) ===== #}
      <div class="tab-pane fade" id="tab-blacklist" role="tabpanel">
        <h4>Blacklisted variants</h4>
        <p class="text-muted small mb-2">
          Calls removed from the clinical table by the SNV blacklist (<code>references/blacklist_file.tsv</code>): curated artefacts, and
          loci derived from the panel-of-normals cohort
          (<code>UBIQUITOUS_IN_NORMALS</code>: same allele in at least half the normals; <code>RECURRENT_IN_NORMALS_LOWVAF</code>: in at least 10% of normals
          below 25% VAF with caller support; <code>POPULATION_POLYMORPHISM_LOCAL</code>: germline-range VAF in at least 10% of normals). The evidence column
          gives the cohort count and VAF range. {{ _bl_supported | length }} of {{ _bl_rows | length }} rows have two or more callers.
        </p>
        {% if _bl_rows %}
          <div class="table-responsive">
            <table id="blacklist-table" class="table table-sm table-striped table-hover w-100">
              <thead><tr><th>gene</th><th>position</th><th>HGVSc</th><th>HGVSp</th><th>class</th><th>VAF %</th><th>callers</th><th>n</th><th>reason</th><th>evidence</th><th>added</th></tr></thead>
              <tbody>
                {% for r in _bl_rows %}
                  {% set _parts = (r.Blacklist_Reason or '') | string | replace('|', '\u0001') | string %}
                  {% set _p = _parts.split('\u0001') %}
                  <tr><td>{{ r.Gene }}</td><td class="text-nowrap">{{ r.Chr }}:{{ r.Start }} {{ r.Ref }}&gt;{{ r.Alt }}</td>
                      <td>{{ r.HGVSc if r.HGVSc != '-1' else '' }}</td><td>{{ r.HGVSp if r.HGVSp != '-1' else '' }}</td>
                      <td>{{ r.Variant_Class if r.Variant_Class is defined else '' }}</td><td>{{ r.VAF_pct if r.VAF_pct != '-1' else '' }}</td>
                      <td>{{ r.Callers if r.Callers != '-1' else '' }}</td><td>{{ r.VariantCaller_Count if r.VariantCaller_Count != '-1' else '' }}</td>
                      <td>{{ _p[1] if _p | length > 1 else _p[0] }}</td><td class="small">{{ _p[2] if _p | length > 2 else '' }}</td><td>{{ r.Blacklist_Date }}</td></tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="tspipe-empty">No blacklisted variants in this sample.</div>
        {% endif %}
      </div>

      {# ===== Spike-in tab (SPIKEIN_V1, D13) ===== #}
      {% if ctx.spikein %}
      <div class="tab-pane fade" id="tab-spikein" role="tabpanel">
        <h4>Spike-in regions and germline risk SNPs</h4>
        <p class="text-muted small mb-2">
          Non-exonic targets of the panel (<code>assets/&lt;panel&gt;/spikein_regions.tsv</code>): regulatory regions whose calls the
          consequence filter keeps out of the clinical table, and germline B-ALL risk SNPs genotyped directly from the BAM.
          Region coverage is the mean over the interval (duplicates included) against the {{ ctx.spikein.tier_x }}x reportability tier.
          Every <code>somaticseq.filtered.tsv</code> call inside a region is listed with its Filter value; none of it has been reviewed for
          reporting. SNP genotypes are germline calls read from a tumour sample: a copy-number change or copy-neutral LOH on that
          chromosome can shift the allele fraction. Sites below {{ ctx.spikein.min_depth }}x are not called.
        </p>

        <h5 class="mt-3">Regions</h5>
        <div class="table-responsive">
          <table id="spikein-regions-table" class="table table-sm table-striped w-100">
            <thead><tr><th>region</th><th>gene</th><th>interval (hg38)</th><th>bp</th><th>mean cov</th><th>&ge;100x %</th><th>&ge;250x %</th><th>&ge;500x %</th><th>{{ ctx.spikein.tier_x }}x</th><th>calls</th><th>note</th></tr></thead>
            <tbody>
            {% for r in ctx.spikein.regions %}
              <tr><td>{{ r.name }}</td><td>{{ r.gene }}</td><td class="text-nowrap">{{ r.chrom }}:{{ r.start }}-{{ r.end }}</td><td>{{ r.length }}</td>
                  <td>{{ '%.0f' | format(r.mean_cov) if r.mean_cov is not none else 'n/a' }}</td>
                  <td>{{ r.pct_100x if r.pct_100x is not none else '' }}</td><td>{{ r.pct_250x if r.pct_250x is not none else '' }}</td><td>{{ r.pct_500x if r.pct_500x is not none else '' }}</td>
                  <td>{% if r.at_tier is none %}<span class="badge bg-secondary">no coverage row</span>{% elif r.at_tier %}<span class="badge bg-success">PASS</span>{% else %}<span class="badge bg-warning text-dark">BELOW</span>{% endif %}</td>
                  <td>{{ r.variants | length }}</td><td class="small">{{ r.description }}</td></tr>
            {% endfor %}
            </tbody>
          </table>
        </div>

        <h5 class="mt-3">Calls inside spike-in regions <span class="badge bg-secondary">{{ ctx.spikein.n_variants }}</span></h5>
        {# SPIKEIN_V1c (D13b): rendered by the shared variant browser, see body_scripts #}
        {% if ctx.spikein.region_variants %}
          <p class="text-muted small mb-1">Same cards and link-outs as the Variants tabs; the region is the gene column (TERC, GATA2, MLH1 ...).</p>
          <div id="spikein-browser"></div>
        {% else %}
          <div class="tspipe-empty">No calls inside the spike-in regions in this sample.</div>
        {% endif %}

        <h5 class="mt-3">Germline risk SNP genotypes</h5>
        <div class="table-responsive">
          <table id="spikein-snps-table" class="table table-sm table-striped w-100">
            <thead><tr><th>site</th><th>rsID</th><th>gene</th><th>position (hg38)</th><th>ref</th><th>alt</th><th>ref n</th><th>alt n</th><th>depth</th><th>alt AF</th><th>genotype</th><th>risk allele</th><th>risk copies</th><th>status</th><th>caller Filter</th><th>links</th></tr></thead>
            <tbody>
            {% for s in ctx.spikein.snps %}
              <tr><td>{{ s.name }}</td><td>{{ s.rsid }}{% if s.rsid_alias and s.rsid_alias != '-' %} <span class="text-muted small">({{ s.rsid_alias }})</span>{% endif %}</td><td>{{ s.gene }}</td>
                  <td class="text-nowrap">{{ s.chrom }}:{{ s.pos }}</td><td>{{ s.ref if s.ref is defined else '' }}</td><td>{{ s.alt if s.alt is defined else '' }}</td>
                  <td>{{ s.ref_count if s.ref_count is defined else '' }}</td><td>{{ s.alt_count if s.alt_count is defined else '' }}</td><td>{{ s.depth if s.depth is defined else '' }}</td><td>{{ s.alt_af if s.alt_af is defined else '' }}</td>
                  <td>{% if s.genotype is defined and s.genotype != '-' %}<span class="badge {% if s.genotype == 'het' %}bg-info text-dark{% elif s.genotype == 'hom_alt' %}bg-primary{% else %}bg-secondary{% endif %}">{{ s.genotype }}</span>{% endif %}</td>
                  <td>{{ s.risk_allele }}</td>
                  <td>{% if s.risk_copies is defined and s.risk_copies in ['1', '2'] %}<span class="badge bg-warning text-dark">{{ s.risk_copies }}</span>{% elif s.risk_copies is defined %}{{ s.risk_copies }}{% endif %}</td>
                  <td>{% if s.status == 'OK' %}<span class="badge bg-success">OK</span>{% else %}<span class="badge bg-warning text-dark">{{ s.status }}</span>{% endif %}</td>
                  <td class="small">{% if s.filtered_row %}{{ s.filtered_row.Filter }} ({{ s.filtered_row.VAF_pct }}%){% else %}not called{% endif %}</td>
                  {# SPIKEIN_V1c (D13b): link-outs #}
                  {% set _c = s.chrom | replace('chr', '') %}
                  {% set _ref = s.ref if (s.ref is defined and s.ref != '-') else '' %}
                  {% set _alt = s.alt if (s.alt is defined and s.alt != '-') else (s.risk_allele if (s.risk_allele != '-' and s.risk_allele != _ref) else '') %}
                  <td class="small text-nowrap">
                    {% if s.rsid and s.rsid != '-' %}<a href="https://www.ncbi.nlm.nih.gov/snp/{{ s.rsid }}" target="_blank" rel="noopener">dbSNP</a>{% endif %}
                    {% if _ref and _alt %}
                      &middot; <a href="https://franklin.genoox.com/clinical-db/variant/snp/chr{{ _c }}-{{ s.pos }}-{{ _ref }}-{{ _alt }}-hg38" target="_blank" rel="noopener">Franklin</a>
                      &middot; <a href="https://genebe.net/variant/hg38/chr{{ _c }}-{{ s.pos }}-{{ _ref }}-{{ _alt }}" target="_blank" rel="noopener">GeneBe</a>
                    {% endif %}
                  </td></tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
      {% endif %}

      <div class="tab-pane fade" id="tab-filtered" role="tabpanel">
        <h4>All filtered variants</h4>
        <p class="text-muted small mb-3">
          Full annotated set from <code>somaticseq_filtered.tsv</code>. The filter
          panel includes population-frequency and filter-status controls. Click a
          variant to see all annotations. No IGV jump from this tab (the IGV report
          is built from the clinical set only).
        </p>
        {% if ctx.filtered and ctx.filtered.rows %}
          <div id="filtered-browser"></div>
        {% else %}
          <div class="tspipe-empty">No filtered variants file found.</div>
        {% endif %}
      </div>

      {# ===== FLT3 tab ===== #}
      <div class="tab-pane fade" id="tab-flt3" role="tabpanel">
        <h4>FLT3-ITD</h4>
        {% if ctx.flt3 is none %}
          <div class="tspipe-empty">FLT3 consensus file not available.</div>
        {% elif ctx.flt3.n_positive == 0 %}
          <div class="alert alert-success" role="alert">
            <strong>No FLT3-ITD detected</strong> in this sample by consensus calling.
          </div>
        {% else %}
          {% for r in ctx.flt3.rows %}
            <div class="card mb-3">
              <div class="card-header">
                <strong>Event {{ loop.index }}</strong>
                &middot; status: <code>{{ r.status }}</code>
                &middot; {{ r.n_tools }} tools
                {# IGV_V2A (D11): nearest IGV-report row to the ITD position, within 300 bp #}
                {% set ns = namespace(uid=none, best=301) %}
                {% for k, u in (ctx.igv.lookup if ctx.igv else {}).items() %}
                  {% set parts = k.split(':') %}
                  {% if parts[0] == 'chr13' and parts[1] and ((parts[1]|int) - (r.pos_hg38|int))|abs < ns.best %}
                    {% set ns.best = ((parts[1]|int) - (r.pos_hg38|int))|abs %}{% set ns.uid = u %}
                  {% endif %}
                {% endfor %}
                {% if ctx.files.igv_report and ns.uid is not none %}
                  <span class="vb-igv-chip vb-igv-chip-ok flt3-igv-chip ms-2" data-igv-uid="{{ ns.uid }}" title="Open the ITD locus in IGV">IGV &rarr;</span>
                {% elif ctx.files.igv_report %}
                  <span class="vb-igv-chip vb-igv-chip-missing ms-2" title="No variant row within 300 bp of the ITD in the IGV report">no IGV</span>
                {% endif %}
              </div>
              <div class="card-body">
                <dl class="row mb-0">
                  <dt class="col-sm-3">Length</dt>            <dd class="col-sm-9">{{ r.length_bp }} bp ({{ r.length_range }})</dd>
                  <dt class="col-sm-3">Position (hg38)</dt>   <dd class="col-sm-9"><code>chr13:{{ r.pos_hg38|int }}</code></dd>   {# IGV_V2A: integer, was the consensus mean #}
                  <dt class="col-sm-3">VAF range</dt>         <dd class="col-sm-9">{{ r.vaf_pct_min }}% &ndash; {{ r.vaf_pct_max }}% (mean {{ r.vaf_pct_mean }}%)</dd>
                  <dt class="col-sm-3">Allelic ratio</dt>     <dd class="col-sm-9">{{ r.ar_min }} &ndash; {{ r.ar_max }} (mean {{ r.ar_mean }})</dd>
                  <dt class="col-sm-3">Domain</dt>            <dd class="col-sm-9">{{ r.domain or r.domain_derived or "—" }}</dd>   {# IGV_V2A: derived from HGVSp when the tools give none #}
                  <dt class="col-sm-3">HGVSc / HGVSp</dt>     <dd class="col-sm-9"><code>{{ r.hgvsc }}</code> &middot; <code>{{ r.hgvsp }}</code></dd>
                  <dt class="col-sm-3">Tools</dt>             <dd class="col-sm-9">{{ r.tools }}</dd>
                </dl>
                <details class="mt-3">
                  <summary class="text-muted small">Raw per-tool calls</summary>
                  <pre class="bg-light p-2 small mb-0">{{ r.raw_calls }}</pre>
                </details>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>

      {# ===== CNV tab ===== #}
      <div class="tab-pane fade" id="tab-cnv" role="tabpanel">
        <div class="d-flex justify-content-between align-items-start mb-3">
          <div>
            <h4 class="mb-1">Copy number variants</h4>
            <p class="text-muted small mb-0">
              Tick a plot's "Include in report" box to add it to the Reporting tab.
              Selections persist in this browser via <code>localStorage</code>.
            </p>
          </div>
          <div>
            <span id="cnv-selection-count-badge" class="badge bg-secondary" style="display:none">0</span>
          </div>
        </div>

        {# ---- v2: consensus, PURPLE, DECoN, chromosome pages, exon plots (MARKER DASH_CNV_V1) ---- #}
        {% if ctx.cnv.purple or ctx.cnv.sex_check %}
          <div class="alert alert-light border small mb-3">
            {% if ctx.cnv.purple %}
              <strong>PURPLE</strong>: status {{ ctx.cnv.purple.status }}, purity {{ ctx.cnv.purple.purity }},
              ploidy {{ ctx.cnv.purple.ploidy }}, sex {{ ctx.cnv.purple.gender }}
              {% if ctx.cnv.purple.trusted != 'TRUE' %}<span class="badge bg-warning text-dark">advisory</span>{% endif %}
            {% endif %}
            {% if ctx.cnv.sex_check %}
              &nbsp;|&nbsp; <strong>Sex check</strong>: {{ ctx.cnv.sex_check.get('resolved_sex', ctx.cnv.sex_check.get('inferred_sex', '')) }}
              (X/A {{ ctx.cnv.sex_check.get('x_a_ratio', '') }}, {{ ctx.cnv.sex_check.get('status', '') }})
            {% endif %}
            {% if ctx.cnv.consensus_tiers %}
              &nbsp;|&nbsp; <strong>Consensus</strong>:
              {% for k, v in ctx.cnv.consensus_tiers.items() %}<span class="badge bg-secondary">{{ k }} {{ v }}</span> {% endfor %}
            {% endif %}
            {% if ctx.cnv.blacklisted %}
              &nbsp;|&nbsp; blacklisted: {{ ctx.cnv.blacklisted | join(', ') }}
            {% endif %}
          </div>
        {% endif %}

        {% if ctx.cnv.consensus_table and ctx.cnv.consensus_table.rows %}
          <h5 class="mt-2">Consensus CNV calls (K CNVkit, G GATK, B BAF, P PureCN, E DECoN, H PURPLE)</h5>
          <p class="text-muted small mb-2">
            Non-neutral genes from <code>cnv_consensus_multi.py</code>. TIER_1: depth direction plus an
            independent arm; TIER_2: two depth arms or two independent arms; TIER_3: single arm;
            REVIEW: arms disagree. Blacklisted genes are excluded.
          </p>
          {# DASH_GLOSS_V1: column key, collapsed by default #}
          <details class="small text-muted mb-2">
            <summary>Column key</summary>
            <table class="table table-sm table-borderless mb-0" style="max-width: 1100px;">
              <tbody>
                <tr><td class="text-nowrap"><code>gene, cytoband, chrom, start, end</code></td><td>gene symbol, UCSC cytoband (hg38), and the span of the gene's targets</td></tr>
                <tr><td class="text-nowrap"><code>consensus_call</code></td><td>GAIN, LOSS, CNLOH, NEUTRAL, DISCORDANT (arms disagree) or BLACKLISTED</td></tr>
                <tr><td class="text-nowrap"><code>tier</code></td><td>TIER_1: a depth arm (K or G) and an independent arm (B, P, E, H) agree and the LOO false-positive rate is acceptable; TIER_2: both depth arms agree (LOO ok) or two independent arms agree; TIER_3: a single arm; REVIEW: arms contradict</td></tr>
                <tr><td class="text-nowrap"><code>flags</code></td><td>letters of the arms that voted: K G B P E H</td></tr>
                <tr><td class="text-nowrap"><code>k_call, k_cn, k_log2</code></td><td>K = CNVkit (read depth vs the sex-matched panel of normals): call, integer copy number, segment log2 ratio</td></tr>
                <tr><td class="text-nowrap"><code>g_call, g_seg_log2</code></td><td>G = GATK ModelSegments (read depth, same PoN): call, segment log2 ratio</td></tr>
                <tr><td class="text-nowrap"><code>b_call</code></td><td>B = B-allele frequency / cnLOH (17p region in the current version): LOSS, CNLOH or NEUTRAL</td></tr>
                <tr><td class="text-nowrap"><code>p_call, p_C</code></td><td>P = PureCN: call and absolute copy number; advisory only when the purity fit is flagged</td></tr>
                <tr><td class="text-nowrap"><code>e_call, e_bf</code></td><td>E = DECoN (exon-level, multi-exon deletions): call and Bayes factor</td></tr>
                <tr><td class="text-nowrap"><code>h_call, h_cn_min, h_cn_max, h_loh</code></td><td>H = PURPLE (hmftools, purity/ploidy adjusted): call, minimum and maximum copy number over the gene, LOH flag; advisory on low purity</td></tr>
                <tr><td class="text-nowrap"><code>loo_fp_any</code></td><td>fraction of panel-of-normals samples in which this gene was called non-neutral in leave-one-out; must be below 0.10 for TIER_1 or TIER_2</td></tr>
                <tr><td class="text-nowrap"><code>driver_role</code></td><td>hmftools DriverGenePanel: ONCO (oncogene) or TSG (tumour suppressor)</td></tr>
                <tr><td class="text-nowrap"><code>clingen_hi, clingen_ts</code></td><td>ClinGen dosage-sensitivity scores for haploinsufficiency / triplosensitivity: 3 sufficient evidence, 2 emerging, 1 little, 0 none, 30 autosomal-recessive phenotype, 40 dosage sensitivity unlikely; NA when the gene is not curated</td></tr>
              </tbody>
            </table>
          </details>
          {# DASH_TIER_V1: tier filter; first button is the default view #}
          <div id="cnv-tier-filter" class="btn-group btn-group-sm mb-2" role="group" aria-label="Tier filter">
            <button type="button" class="btn btn-outline-secondary" data-tiers="TIER_1,TIER_2">Reportable (TIER_1 + TIER_2)</button>
            <button type="button" class="btn btn-outline-secondary" data-tiers="TIER_1">TIER_1</button>
            <button type="button" class="btn btn-outline-secondary" data-tiers="TIER_2">TIER_2</button>
            <button type="button" class="btn btn-outline-secondary" data-tiers="TIER_3">TIER_3</button>
            <button type="button" class="btn btn-outline-secondary" data-tiers="REVIEW">REVIEW</button>
            <button type="button" class="btn btn-outline-secondary" data-tiers="">All</button>
          </div>
          {{ macros.render_datatable('cnv-consensus-table', ctx.cnv.consensus_table.columns, ctx.cnv.consensus_table.rows) }}
        {% elif ctx.cnv.consensus_tiers is defined %}
          <div class="tspipe-empty">No non-neutral consensus CNV calls.</div>
        {% endif %}

        {% if ctx.cnv.decon_table and ctx.cnv.decon_table.rows %}
          <h5 class="mt-4">DECoN exon-level calls</h5>
          {# DASH_DECON_V1: BF explanation and column key; DASH_DECON_V1b: vocabulary corrected #}
          <p class="text-muted small mb-2">
            Exon-level calls from DECoN, listed at Bayes factor (BF) &ge; 5; sub-threshold calls carry
            decision BELOW_BF. BF is on a log10 scale, so BF 5 is about 100,000:1 evidence for a copy-number
            change over none. Only calls at BF &ge; 8 (multi-exon deletions) or BF &ge; 12 (single exon)
            vote as arm E in the consensus table above. Reads.ratio near 0.5 indicates a heterozygous
            deletion, near 0 a homozygous deletion, near 1.5 a single-copy gain.
          </p>
          <details class="small text-muted mb-2">
            <summary>Column key</summary>
            <table class="table table-sm table-borderless mb-0" style="max-width: 1100px;">
              <tbody>
                <tr><td class="text-nowrap"><code>Gene, CNV.type, N.exons</code></td><td>gene, deletion or duplication, number of consecutive exons in the call</td></tr>
                <tr><td class="text-nowrap"><code>Chromosome, Start, End</code></td><td>span of the called exons (hg38)</td></tr>
                <tr><td class="text-nowrap"><code>BF</code></td><td>Bayes factor, log10 scale: the evidence for a copy-number change over no change, from the sample's exon read depth against the sex-matched pool of normals. BF 5 is roughly 100,000:1; larger is stronger. Calls with BF &ge; 5 are listed; a call enters the consensus as arm E only at BF &ge; 8 for multi-exon deletions and BF &ge; 12 for single-exon calls</td></tr>
                <tr><td class="text-nowrap"><code>Reads.ratio</code></td><td>observed / expected read depth over the called exons: about 0.5 for a heterozygous deletion, about 0 for a homozygous deletion, about 1.5 for a single-copy gain</td></tr>
                <tr><td class="text-nowrap"><code>decision</code></td><td>PASS: single-exon call at BF &ge; 12; PASS_MULTIDEL: multi-exon deletion at BF &ge; 8; BELOW_BF: listed for context only, under the reporting threshold</td></tr>
                <tr><td class="text-nowrap"><code>reportable</code></td><td>yes when decision is PASS or PASS_MULTIDEL, otherwise no</td></tr>
                <tr><td class="text-nowrap"><code>exon_flags</code></td><td>reserved for per-exon caveats (probe-site variant, recurrent in normals, low power); '-' in the current version</td></tr>
              </tbody>
            </table>
          </details>
          {{ macros.render_datatable('cnv-decon-table', ctx.cnv.decon_table.columns, ctx.cnv.decon_table.rows) }}
        {% endif %}

        {# ---- genome overview (arm medians) + reconCNV (MARKER VIZ_V1b) ---- #}
        {% if ctx.cnv.genome_overview %}
          <h5 class="mt-4">Genome-wide</h5>
          <p class="text-muted small mb-2">Per-bin log2 with one median line per chromosome arm (red below -0.25, green above +0.20), BAF (grey balanced, green deviated), PURPLE copy number. Arm medians are printed under the chromosome labels.</p>
          <div class="row g-3">
            {{ macros.render_cnv_plot_card('genome_overview::1', 'Genome-wide overview', ctx.cnv.genome_overview, 'col-12') }}
          </div>
        {% endif %}
        {% if ctx.cnv.reconcnv %}
          <h5 class="mt-4">reconCNV (interactive)</h5>
          <p class="text-muted small mb-2">Bokeh view of the CNVkit ratio, segments and het SNPs. <a href="{{ ctx.cnv.reconcnv }}" target="_blank">Open in a new tab</a>.</p>
          <div class="ratio" style="--bs-aspect-ratio: 60%;"><iframe src="{{ ctx.cnv.reconcnv }}" loading="lazy" style="border:1px solid #dee2e6;"></iframe></div>
        {% endif %}

        {% if ctx.cnv.chrom_pages %}
          <h5 class="mt-4">Chromosome pages ({{ ctx.cnv.chrom_pages|length }})</h5>
          <p class="text-muted small mb-2">
            Target space, genomic order: depth per exon/backbone/SNP window (green neutral, red loss, blue gain),
            BAF from the panel's het catalog (grey balanced, green deviated), PURPLE copy number, and one exon
            panel per gene with DECoN brackets.
          </p>
          {# MARKER DASH_CNV_V1b: one sub-tab per chromosome #}
          <ul class="nav nav-pills flex-wrap mb-2" id="cnv-chrom-tabs" role="tablist">
            {% for item in ctx.cnv.chrom_pages %}
              <li class="nav-item" role="presentation">
                <button class="nav-link py-0 px-2 small{% if loop.first %} active{% endif %}" data-bs-toggle="pill" data-bs-target="#cnv-chrom-{{ item.chrom }}" type="button" role="tab">{{ item.chrom | replace('chr', '') }}</button>
              </li>
            {% endfor %}
          </ul>
          <div class="tab-content" id="cnv-chrom-panes">
            {% for item in ctx.cnv.chrom_pages %}
              <div class="tab-pane fade{% if loop.first %} show active{% endif %}" id="cnv-chrom-{{ item.chrom }}" role="tabpanel">
                <div class="row g-3">
                  {{ macros.render_cnv_plot_card('chrom_page::' ~ item.chrom, item.chrom ~ ' (' ~ item.n_targets ~ ' targets, ' ~ item.n_baf_sites ~ ' BAF sites)', item.path, 'col-12') }}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if ctx.cnv.exon_plots %}
          <h5 class="mt-4">Exon-level figures ({{ ctx.cnv.exon_plots|length }})</h5>
          <p class="text-muted small mb-2">Chromosomes with a consensus call, a DECoN call at BF &ge; 5, or a focal-CNV gene.</p>
          <div class="row g-3">
            {% for item in ctx.cnv.exon_plots %}
              {{ macros.render_cnv_plot_card('exon_plot::' ~ item.chrom, item.chrom ~ ': ' ~ item.reasons, item.path, 'col-12') }}
            {% endfor %}
          </div>
        {% endif %}


        {# legacy CNV views removed: MARKER DASH_CNV_V1a #}
      </div>

      {# ===== IGV tab ===== #}
      <div class="tab-pane fade" id="tab-igv" role="tabpanel">
        <h4>IGV report</h4>
        {% if ctx.files.igv_report %}
          <iframe id="igv-frame" class="tspipe-iframe-full" data-src="./{{ ctx.files.igv_report }}" loading="lazy"></iframe>
        {% else %}
          <div class="tspipe-empty">IGV report not available.</div>
        {% endif %}
      </div>

      {# ===== Reporting tab ===== #}
      <div class="tab-pane fade" id="tab-reporting" role="tabpanel">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h4 class="mb-1">Reporting</h4>
            <p class="text-muted small mb-0">
              Variants ticked in the Clinical tab and CNV plots ticked in the CNV
              tab appear here in selection order. Selections persist in this
              browser via <code>localStorage</code>. AMP/ASCO/CAP Tier and the
              CNV interpretation captions are editable and also persist.
              When CancerVar annotation is enabled at build time, the tier column
              is pre-filled with the CancerVar (AMP/ASCO/CAP 2017) tier for each
              newly-selected variant; you can edit or clear it like any manual value.
            </p>
          </div>
          <div class="d-flex gap-2 align-items-start">
            <button type="button" id="reporting-copy-btn" class="btn btn-sm btn-primary" disabled>
              Copy as TSV
            </button>
            <button type="button" id="reporting-clear-btn" class="btn btn-sm btn-outline-danger" disabled>
              Clear all
            </button>
            <span id="reporting-copied-toast" class="vb-copied-toast">Copied!</span>
          </div>
        </div>

        <div id="reporting-empty" class="tspipe-empty">
          Nothing triaged yet. Open the "Variants &mdash; Clinical" tab and mark a
          variant <strong>Incl</strong> (include in report) or <strong>Excl</strong>
          (reviewed, not reported), and/or open the "CNV" tab and tick a plot's
          "Include" checkbox.
        </div>

        {# ----- Variants section ----- #}
        <div id="reporting-variants-section" style="display:none">
          <h5 class="mt-2 mb-2">
            Variants <span id="reporting-variant-count-badge" class="badge bg-secondary ms-1">0</span>
          </h5>
          <div id="reporting-table-wrap" class="table-responsive">
            <table class="table table-sm table-hover align-middle" id="reporting-table">
              <thead class="table-light">
                <tr>
                  {# DASH_LAYOUT_V1 (D4, D5): fixed column widths so the page never widens; every cell wraps #}
                  <th scope="col" style="width:72px"></th>
                  <th scope="col" style="width:90px">Gene</th>
                  <th scope="col" style="width:17%">Genomic variant</th>
                  <th scope="col" style="width:14%">Protein variant</th>
                  <th scope="col" style="width:14%">Transcript Variant</th>
                  <th scope="col" style="width:17%">CAVA (MANE RefSeq)</th>   {# DASH_REPORTING_CAVA_V1 #}
                  <th scope="col" style="width:60px">Exon</th>
                  <th scope="col" style="width:13%">COSMIC database reference</th>
                  <th scope="col" style="width:64px">VAF (%)</th>
                  <th scope="col" style="width:170px">AMP/ASCO/CAP Tier (somatic)</th>
                </tr>
              </thead>
              <tbody id="reporting-tbody"></tbody>
            </table>
          </div>
        </div>

        {# ----- Excluded variants section (reviewed, not reported) ----- #}
        <div id="reporting-excluded-section" class="mt-4" style="display:none">
          <h5 class="mt-2 mb-2">
            Excluded &mdash; reviewed, not reported
            <span id="reporting-excluded-count-badge" class="badge bg-secondary ms-1">0</span>
          </h5>
          <p class="text-muted small mb-2">
            Variants marked <strong>Excl</strong> in the Clinical tab. The reason
            is editable and persists in this browser; it is included in the
            copied TSV so the audit trail stays with the report.
          </p>
          <div class="table-responsive">
            <table class="table table-sm table-hover align-middle" id="reporting-excluded-table">
              <thead class="table-light">
                <tr>
                  <th scope="col" style="width:32px"></th>
                  <th scope="col">Gene</th>
                  <th scope="col">Genomic variant</th>
                  <th scope="col">Protein variant</th>
                  <th scope="col">Transcript Variant</th>
                  <th scope="col">Exon</th>
                  <th scope="col">Reason not reported</th>
                  <th scope="col" style="width:32px"></th>
                </tr>
              </thead>
              <tbody id="reporting-excluded-tbody"></tbody>
            </table>
          </div>
        </div>

        {# ----- CNV findings section ----- #}
        <div id="reporting-cnv-section" class="mt-4" style="display:none">
          <h5 class="mt-2 mb-2 d-flex justify-content-between align-items-center">
            <span>
              CNV findings
              <span id="reporting-cnv-count-badge" class="badge bg-secondary ms-1">0</span>
            </span>
            <button type="button" id="reporting-clear-cnv-btn" class="btn btn-sm btn-outline-secondary">
              Clear CNV selections
            </button>
          </h5>
          <p class="text-muted small mb-3">
            Each plot has an editable interpretation field that persists in
            this browser. Use Browser &rarr; Print &rarr; Save as PDF to produce
            a print-ready report; plots are styled to avoid page-breaks across
            an image.
          </p>
          <div id="reporting-cnv-list"></div>
        </div>
      </div>

      {# ===== Files tab ===== #}
      <div class="tab-pane fade" id="tab-files" role="tabpanel">
        <h4>Files</h4>
        <p class="text-muted small">Direct links to the raw artefacts in this sample's directory.</p>
        <ul class="list-group">
          {% for fname, desc in ctx.files.listing %}
            <li class="list-group-item d-flex justify-content-between align-items-center">
              <span><a href="./{{ fname }}">{{ fname }}</a></span>
              <span class="text-muted small">{{ desc }}</span>
            </li>
          {% endfor %}
        </ul>
      </div>

    </div>
  </main>
</div>
{% endblock %}

{% block body_scripts %}
<script>
  // IGV lookup: chr:pos:ref:alt -> unique_id (built at build time from igv_report.html).
  const igvLookup = {{ (ctx.igv.lookup if ctx.igv else {}) | tojson }};

  // Optional GeneBe annotations, populated only when --annotate-genebe was used.
  const genebeAnnotations = {{ ctx.genebe | tojson }};

  // Optional MobiDetails annotations (full variant_data), only when --annotate-mobidetails was used.
  const mobidetailsAnnotations = {{ ctx.mobidetails | tojson }};

  // Optional OncoKB annotations, populated only when --annotate-oncokb was used.
  const oncokbAnnotations = {{ ctx.oncokb | tojson }};

  // Optional CancerVar (AMP/ASCO/CAP) annotations, populated only when
  // --annotate-cancervar was used.
  const cancervarAnnotations = {{ ctx.cancervar | tojson }};

  // Variant data, embedded inline for client-side filtering.
  const clinicalVariants = {{ (ctx.clinical.rows if ctx.clinical else []) | tojson }};
  const filteredVariants = {{ (ctx.filtered.rows if ctx.filtered else []) | tojson }};

  $(document).ready(function () {
    // Initialise the per-sample reporting selection store. All keys in
    // localStorage are namespaced by sample so opening a second sample in a
    // new tab doesn't blend selections.
    if (window.tspipeReporting) {
      window.tspipeReporting.setSample({{ ctx.sample | tojson }});

      /* [triage-share export/import] Per-reviewer decision sharing across machines.
         Save downloads <sample>.triage.<reviewer>.json; Load imports one back.
         Decisions live in localStorage (per-machine), so this is how a
         resident's triage reaches another computer: save, drop on the shared
         drive, the next person loads it. Imported state is editable; saving
         always writes under the loader's own name. */
      (function () {
        var SAMPLE = {{ ctx.sample | tojson }};
        var NAME_KEY = "tspipe_reviewer_name";

        function reviewerName(forcePrompt) {
          var n = "";
          try { n = window.localStorage.getItem(NAME_KEY) || ""; } catch (e) {}
          if (!n || forcePrompt) {
            n = window.prompt("Your name (used to label your decisions file):", n || "");
            if (n) { try { window.localStorage.setItem(NAME_KEY, n); } catch (e) {} }
          }
          return n || "";
        }

        function safe(s) { return String(s || "").replace(/[^A-Za-z0-9._-]+/g, "_"); }

        function doSave() {
          var name = reviewerName(false);
          if (!name) return;
          var bundle = window.tspipeReporting.exportAll(name);
          if (!bundle) { alert("Nothing to save yet, or storage is unavailable."); return; }
          var blob = new Blob([JSON.stringify(bundle, null, 2)], { type: "application/json" });
          var url = URL.createObjectURL(blob);
          var a = document.createElement("a");
          a.href = url;
          a.download = safe(SAMPLE) + ".triage." + safe(name) + ".json";
          document.body.appendChild(a); a.click();
          document.body.removeChild(a); URL.revokeObjectURL(url);
          setBanner("Saved decisions as " + a.download + " - move it to the shared drive.");
        }

        function doLoad(file) {
          var reader = new FileReader();
          reader.onload = function () {
            var bundle;
            try { bundle = JSON.parse(reader.result); }
            catch (e) { alert("Could not read that file (not valid JSON)."); return; }
            var res = window.tspipeReporting.importAll(bundle);
            if (!res.ok) {
              if (res.reason === "sample-mismatch") {
                alert("That file is for sample '" + res.got + "', but this report is '" +
                      res.want + "'. Not loaded.");
              } else {
                alert("Could not load that file (" + res.reason + ").");
              }
              return;
            }
            setBanner("Loaded decisions from " + (res.reviewer || "unknown") +
                      (res.savedAt ? " (saved " + res.savedAt.slice(0, 10) + ")" : "") +
                      " - your edits will save under your own name.");
            /* repaint the Reporting table if a renderer hook exists */
            if (typeof window.tspipeRenderReporting === "function") {
              try { window.tspipeRenderReporting(); } catch (e) {}
            } else {
              window.tspipeReporting.onChange && window.tspipeReporting.load();
            }
          };
          reader.readAsText(file);
        }

        var bannerEl = null;
        function setBanner(msg) {
          if (!bannerEl) return;
          bannerEl.textContent = msg;
          bannerEl.style.display = msg ? "" : "none";
        }

        function mount() {
          var pane = document.getElementById("tab-reporting") ||
                     document.querySelector('[id*="reporting"]');
          if (!pane) return;
          var bar = document.createElement("div");
          bar.className = "d-flex align-items-center gap-2 mb-2 flex-wrap";
          var save = document.createElement("button");
          save.type = "button";
          save.className = "btn btn-sm btn-outline-primary";
          save.textContent = "Save my decisions";
          save.addEventListener("click", doSave);
          var load = document.createElement("button");
          load.type = "button";
          load.className = "btn btn-sm btn-outline-secondary";
          load.textContent = "Load decisions";
          var picker = document.createElement("input");
          picker.type = "file"; picker.accept = ".json"; picker.style.display = "none";
          picker.addEventListener("change", function () {
            if (picker.files && picker.files[0]) doLoad(picker.files[0]);
            picker.value = "";
          });
          load.addEventListener("click", function () { picker.click(); });
          var changeName = document.createElement("button");
          changeName.type = "button";
          changeName.className = "btn btn-sm btn-link text-muted p-0 ms-1";
          changeName.textContent = "(change name)";
          changeName.addEventListener("click", function () { reviewerName(true); });
          bannerEl = document.createElement("div");
          bannerEl.className = "text-muted small w-100";
          bannerEl.style.display = "none";
          bar.appendChild(save); bar.appendChild(load);
          bar.appendChild(picker); bar.appendChild(changeName);
          bar.appendChild(bannerEl);
          pane.insertBefore(bar, pane.firstChild);
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", mount);
        } else {
          mount();
        }
      })();
    }

    // ---- Lazy-load iframes on first tab activation ----
    // Each iframe is rendered with data-src instead of src. On the first
    // shown.bs.tab event for a pane, we swap data-src -> src on every iframe
    // inside that pane. This keeps the initial page load small (the IGV
    // report alone can be 5+ MB and would block first paint otherwise).
    document.querySelectorAll('button[data-bs-toggle="pill"]').forEach(function (btn) {
      btn.addEventListener('shown.bs.tab', function () {
        const targetSelector = btn.getAttribute('data-bs-target');
        if (!targetSelector) return;
        const pane = document.querySelector(targetSelector);
        if (!pane) return;
        pane.querySelectorAll('iframe[data-src]').forEach(function (iframe) {
          iframe.src = iframe.getAttribute('data-src');
          iframe.removeAttribute('data-src');
        });
      });
    });

    // IGV_V2A (D11): FLT3 tab chip -> IGV report row (same navigation as the card chips:
    // activate the IGV tab, then set the iframe src to "<report>#row_<uid>"; the router
    // injected into the report clicks the row).
    document.querySelectorAll(".flt3-igv-chip").forEach(function (chip) {
      chip.addEventListener("click", function () {
        const uid = chip.getAttribute("data-igv-uid");
        const frame = document.getElementById("igv-frame");
        if (uid === null || !frame) return;
        const trigger = document.querySelector('button[data-bs-target="#tab-igv"]');
        if (trigger && window.bootstrap && window.bootstrap.Tab) {
          window.bootstrap.Tab.getOrCreateInstance(trigger).show();
        }
        const baseSrc = frame.getAttribute("data-src") || (frame.src || "").replace(/#.*$/, "");
        if (!baseSrc) return;
        frame.src = baseSrc + "#row_" + uid;
        frame.removeAttribute("data-src");
      });
    });

    if (document.getElementById("clinical-browser")) {
      initVariantBrowser({
        containerId: "clinical-browser",
        variants: clinicalVariants,
        filterIds: [
          "somaticseq_verdict", "impact", "consequence", "oncovi",
          "gene", "vaf_min", "alt_count_buttons", "callers_buttons"
        ],
        igvLookup: igvLookup,
        igvFrameId: "igv-frame",
        igvTabSelector: '[data-bs-target="#tab-igv"]',
        genebeAnnotations: genebeAnnotations,
        oncokbAnnotations: oncokbAnnotations,
        cancervarAnnotations: cancervarAnnotations,
        mobidetailsAnnotations: mobidetailsAnnotations,
        enableReportSelect: true
      });
    }

    // ---- Defer filtered-browser init until the tab is first shown ----
    // The filtered TSV can be ~700 KB of inline JSON and produces hundreds of
    // DOM cards. Rendering it on every page load even when the clinician
    // doesn't open the tab is wasteful. We init once on first activation.
    const filteredTabTrigger = document.querySelector('[data-bs-target="#tab-filtered"]');
    if (filteredTabTrigger && document.getElementById("filtered-browser")) {
      let filteredInited = false;
      const initFiltered = function () {
        if (filteredInited) return;
        filteredInited = true;
        initVariantBrowser({
          containerId: "filtered-browser",
          variants: filteredVariants,
          filterIds: [
            "filter_status", "somaticseq_verdict", "impact", "consequence",
            "gene", "vaf_min", "alt_count_buttons", "callers_buttons", "pop_af_max"
          ],
          igvLookup: null,
          igvFrameId: null,
          igvTabSelector: null,
          genebeAnnotations: {},      // filtered tab: no external annotation (large set)
          oncokbAnnotations: {},      // ditto for OncoKB
          cancervarAnnotations: {},   // ditto for CancerVar
          mobidetailsAnnotations: {}, // ditto for MobiDetails
          enableReportSelect: false   // filtered tab is read-only for reporting
        });
      };
      filteredTabTrigger.addEventListener('shown.bs.tab', initFiltered);
      if (filteredTabTrigger.classList.contains('active')) initFiltered();
    }

    // ---- Reporting tab ----
    initReportingTab();

    // ---- CNV tab plot-selection gallery ----
    initCNVGallery();

    if ($('#coverage-table').length)     { $('#coverage-table').DataTable({ pageLength: 25, order: [] }); }
    if ($('#blacklist-table').length)    { $('#blacklist-table').DataTable({ pageLength: 25, order: [[7, 'desc'], [5, 'desc']] }); }   // DASH_BLACKLIST_V1
    // SPIKEIN_V1c (D13b): spike-in region calls through the shared variant browser, initialised on first show
    (function () {
      var el = document.getElementById("spikein-browser");
      if (!el || typeof initVariantBrowser !== "function") return;
      var keys = new Set({{ (ctx.spikein.region_keys if ctx.spikein else []) | tojson }});
      var inited = false;
      function initSpikein() {
        if (inited) return;
        inited = true;
        var rows = filteredVariants.filter(function (r) {
          return keys.has((r.Chr || "") + ":" + (r.Start || "") + ":" + (r.Ref || "") + ":" + (r.Alt || ""));
        });
        initVariantBrowser({
          containerId: "spikein-browser",
          variants: rows,
          filterIds: ["filter_status", "gene", "vaf_min", "callers_buttons"],
          igvLookup: igvLookup,
          igvFrameId: "igv-frame",
          igvTabSelector: '[data-bs-target="#tab-igv"]',
          genebeAnnotations: {},
          oncokbAnnotations: {},
          cancervarAnnotations: {},
          mobidetailsAnnotations: {},
          enableReportSelect: false
        });
      }
      var btn = document.querySelector('[data-bs-target="#tab-spikein"]');
      if (btn) btn.addEventListener("shown.bs.tab", initSpikein);
      if (btn && btn.classList.contains("active")) initSpikein();
    })();
    // DASH_QC_V1: gene tables + per-gene median chart
    if ($('#qc-low-genes-table').length) { $('#qc-low-genes-table').DataTable({ pageLength: 25, order: [[2, 'asc']] }); }
    if ($('#qc-gene-table').length)      { $('#qc-gene-table').DataTable({ pageLength: 25, order: [[2, 'asc']] }); }
    if ($('#qc-regions-table').length)   { $('#qc-regions-table').DataTable({ pageLength: 25, order: [[2, 'asc']] }); }   // DASH_QC_V1e
    const qcCanvas = document.getElementById('qc-gene-chart');
    if (qcCanvas && window.Chart && window.QC_GENES) {
      const qg = window.QC_GENES, qlow = window.QC_GENE_LOW;
      new Chart(qcCanvas, {
        type: 'bar',
        data: { labels: qg.map(function (r) { return r.gene; }),
                datasets: [{ label: 'median exon coverage', data: qg.map(function (r) { return Math.max(r.median_cov, 1); }),
                             backgroundColor: qg.map(function (r) { return r.median_cov < qlow ? '#dc3545' : '#6c757d'; }) }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
                   scales: { x: { ticks: { autoSkip: false, maxRotation: 90, minRotation: 90, font: { size: 8 },
                                           color: function (c) { return (qg[c.index] && qg[c.index].median_cov < qlow) ? '#dc3545' : '#666666'; } } },   // DASH_QC_V1e
                             y: { type: 'logarithmic', title: { display: true, text: 'median exon coverage (x)' } } } },
        plugins: [{ id: 'qcThresholdLine', afterDraw: function (chart) {
          const y = chart.scales.y.getPixelForValue(qlow); const c = chart.ctx;
          c.save(); c.strokeStyle = '#dc3545'; c.setLineDash([4, 3]); c.beginPath();
          c.moveTo(chart.chartArea.left, y); c.lineTo(chart.chartArea.right, y); c.stroke(); c.restore(); } }]
      });
    }
    // DASH_TIER_V1: consensus + DECoN tables as DataTables; tier filter on the consensus table
    if ($('#cnv-consensus-table').length) {
      const cnvTable = $('#cnv-consensus-table').DataTable({ pageLength: 25, order: [] });
      const tierIdx = $('#cnv-consensus-table thead th').toArray()
        .findIndex(function (th) { return th.textContent.trim() === 'tier'; });
      $('#cnv-tier-filter [data-tiers]').on('click', function () {
        $('#cnv-tier-filter .btn').removeClass('active');
        $(this).addClass('active');
        if (tierIdx < 0) { return; }
        const tiers = String($(this).attr('data-tiers') || '');
        const rx = tiers ? '^(' + tiers.split(',').join('|') + ')$' : '';
        cnvTable.column(tierIdx).search(rx, true, false).draw();
      });
      $('#cnv-tier-filter [data-tiers]').first().trigger('click');
    }
    if ($('#cnv-decon-table').length) { $('#cnv-decon-table').DataTable({ pageLength: 25, order: [] }); }
  });

  // ---------------------------------------------------------------------------
  // Reporting tab: render the variants table + CNV section, copy as TSV, clear.
  // ---------------------------------------------------------------------------
  function initReportingTab() {
    const tbody = document.getElementById("reporting-tbody");
    const variantsSection = document.getElementById("reporting-variants-section");
    const excludedSection = document.getElementById("reporting-excluded-section");
    const excludedTbody = document.getElementById("reporting-excluded-tbody");
    const excludedCountBadge = document.getElementById("reporting-excluded-count-badge");
    const cnvSection = document.getElementById("reporting-cnv-section");
    const cnvList = document.getElementById("reporting-cnv-list");
    const emptyState = document.getElementById("reporting-empty");
    const copyBtn = document.getElementById("reporting-copy-btn");
    const clearBtn = document.getElementById("reporting-clear-btn");
    const clearCnvBtn = document.getElementById("reporting-clear-cnv-btn");
    const tabBadge = document.getElementById("reporting-count-badge");
    const variantCountBadge = document.getElementById("reporting-variant-count-badge");
    const cnvCountBadge = document.getElementById("reporting-cnv-count-badge");
    const toast = document.getElementById("reporting-copied-toast");
    if (!tbody || !window.tspipeReporting) return;

    const VARIANT_COLUMNS = [
      "Gene", "Genomic variant", "Protein variant", "Transcript Variant",
      "CAVA transcript variant", "CAVA protein variant", "CAVA alternative alignment",   // DASH_REPORTING_CAVA_V1
      "Exon",
      "COSMIC database reference", "Variant allele frequency (%)",
      "AMP/ASCO/CAP Tier (somatic)"
    ];

    // DASH_REPORTING_CAVA_V1: the live clinical row for a stored selection (matched on
    // chr:pos:ref:alt), so fields added after the selection was stored still render.
    const liveRows = {};
    (typeof clinicalVariants !== "undefined" ? clinicalVariants : []).forEach(function (r) {
      liveRows[(r.Chr || "") + ":" + (r.Start || "") + ":" + (r.Ref || "") + ":" + (r.Alt || "")] = r;
    });
    function isSet(v) { return v !== undefined && v !== null && v !== "" && v !== "-1"; }
    function cavaOf(it) {
      const r = liveRows[it.id] || {};
      const s = it.snapshot || {};
      const tx = isSet(r.CAVA_Transcript) ? r.CAVA_Transcript : (s.cavaTx || "");
      const c  = isSet(r.CAVA_HGVSc) ? r.CAVA_HGVSc : (s.cavaC || "");
      const p  = isSet(r.CAVA_HGVSp) ? r.CAVA_HGVSp : (s.cavaP || "");
      const alt = isSet(r.CAVA_AltAnn) ? r.CAVA_AltAnn : (s.cavaAlt || "");
      const differs = (r.CAVA_HGVSp_Match || s.cavaMatch || "") === "DIFFER";
      return { tx: tx, c: c, p: p, alt: alt, differs: differs,
               cText: c ? ((tx && c.indexOf(":") === -1) ? tx + ":" + c : c) : "" };
    }
    function cosmicOf(it) {
      const r = liveRows[it.id];
      const s = it.snapshot || {};
      if (r && isSet(r.Existing_variation)) return window.tspipeReporting.extractCosmicIds(r.Existing_variation);
      return String(s.cosmic || "").replace(/ID=/g, "").replace(/;/g, ", ");
    }
    const EXCLUDED_COLUMNS = [
      "Gene", "Genomic variant", "Protein variant", "Transcript Variant", "Exon",
      "Reason not reported"
    ];
    const CNV_COLUMNS = ["Label", "Image path", "Interpretation"];

    function escapeHtml(s) {
      return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
      });
    }

    function variantRowToTsv(it) {
      const tier = window.tspipeReporting.getTier(it.id) || "";
      const s = it.snapshot || {};
      const vaf = s.vaf ? Number(s.vaf).toFixed(1) : "";
      const cv = cavaOf(it);   // DASH_REPORTING_CAVA_V1
      return [s.gene || "", s.hgvsG || "", s.hgvsP || "", s.hgvsC || "",
              cv.cText, cv.p, cv.alt, s.exon || "",
              cosmicOf(it), vaf, tier].join("\t");
    }

    function excludedRowToTsv(it) {
      const s = it.snapshot || {};
      const reason = (window.tspipeReporting.getExcludeReason(it.id) || "").replace(/\s+/g, " ");
      return [s.gene || "", s.hgvsG || "", s.hgvsP || "", s.hgvsC || "", s.exon || "",
              reason].join("\t");
    }

    function cnvRowToTsv(it) {
      const s = it.snapshot || {};
      const caption = window.tspipeReporting.getCnvCaption(it.id) || "";
      // Strip newlines from caption so it doesn't break TSV grid
      return [(s.label || ""), (s.path || ""), caption.replace(/\s+/g, " ")].join("\t");
    }

    // DASH_REPORTING_CAVA_V1: CAVA cell -- transcript:c. on one line, p. on the next, alt alignment
    // and the differs-from-VEP flag as small notes.
    function cavaCell(it) {
      const cv = cavaOf(it);
      if (!cv.cText && !cv.p) return '<span class="text-muted">\u2014</span>';
      let html = escapeHtml(cv.cText);
      if (cv.p) html += (html ? "<br>" : "") + escapeHtml(cv.p);
      if (cv.alt) html += '<br><span class="badge bg-light text-dark border" title="Alternative alignment: ' + escapeHtml(cv.alt) + '">alt alignment</span>';
      if (cv.differs) html += ' <span class="badge bg-warning text-dark" title="CAVA protein call differs from VEP">differs from VEP</span>';
      return html;
    }

    function renderVariants(variants) {
      if (variants.length === 0) {
        variantsSection.style.display = "none";
        tbody.innerHTML = "";
        return;
      }
      variantsSection.style.display = "";
      variantCountBadge.textContent = String(variants.length);

      const html = variants.map(function (it, idx) {
        const s = it.snapshot || {};
        const tier = escapeHtml(window.tspipeReporting.getTier(it.id) || "");
        const vaf = s.vaf ? Number(s.vaf).toFixed(1) : "";
        const upDisabled = idx === 0 ? " disabled" : "";
        const downDisabled = idx === variants.length - 1 ? " disabled" : "";
        return '<tr data-vb-key="' + escapeHtml(it.id) + '">' +
                 '<td class="text-muted small">' +
                   '<div class="d-flex align-items-center gap-1">' +
                     '<span>' + (idx + 1) + '</span>' +
                     '<div class="btn-group-vertical reporting-move-group" role="group" aria-label="Reorder variant">' +
                       '<button type="button" class="btn btn-outline-secondary reporting-move-up" data-vb-key="' + escapeHtml(it.id) + '" title="Move up"' + upDisabled + '>\u25B2</button>' +
                       '<button type="button" class="btn btn-outline-secondary reporting-move-down" data-vb-key="' + escapeHtml(it.id) + '" title="Move down"' + downDisabled + '>\u25BC</button>' +
                     '</div>' +
                   '</div>' +
                 '</td>' +
                 '<td>' + escapeHtml(s.gene) + '</td>' +
                 '<td class="font-monospace small">' + escapeHtml(s.hgvsG) + '</td>' +
                 '<td class="font-monospace small">' + escapeHtml(s.hgvsP) + '</td>' +
                 '<td class="font-monospace small">' + escapeHtml(s.hgvsC) + '</td>' +
                 '<td class="font-monospace small">' + cavaCell(it) + '</td>' +   // DASH_REPORTING_CAVA_V1
                 '<td>' + escapeHtml(s.exon || "") + '</td>' +
                 '<td class="font-monospace small reporting-cosmic" title="' + escapeHtml(cosmicOf(it)) + '">' + escapeHtml(cosmicOf(it)) + '</td>' +   // DASH_LAYOUT_V1 (D5); live row since DASH_REPORTING_CAVA_V1
                 '<td>' + escapeHtml(vaf) + '</td>' +
                 '<td><textarea rows="1" class="form-control form-control-sm reporting-tier-input" ' +   // DASH_LAYOUT_V1 (D4): grows with the text
                       'data-vb-key="' + escapeHtml(it.id) + '" ' +
                       'placeholder="-">' + tier + '</textarea></td>' +
               '</tr>';
      }).join("");
      tbody.innerHTML = html;
      autosizeAllTiers();   // DASH_LAYOUT_V1 (D4)
    }

    function renderExcluded(excluded) {
      if (excluded.length === 0) {
        excludedSection.style.display = "none";
        excludedTbody.innerHTML = "";
        return;
      }
      excludedSection.style.display = "";
      excludedCountBadge.textContent = String(excluded.length);

      const html = excluded.map(function (it, idx) {
        const s = it.snapshot || {};
        const reason = escapeHtml(window.tspipeReporting.getExcludeReason(it.id) || "");
        return '<tr data-vb-key="' + escapeHtml(it.id) + '">' +
                 '<td class="text-muted small">' + (idx + 1) + '</td>' +
                 '<td>' + escapeHtml(s.gene) + '</td>' +
                 '<td class="font-monospace small">' + escapeHtml(s.hgvsG) + '</td>' +
                 '<td class="font-monospace small">' + escapeHtml(s.hgvsP) + '</td>' +
                 '<td class="font-monospace small">' + escapeHtml(s.hgvsC) + '</td>' +
                 '<td>' + escapeHtml(s.exon || "") + '</td>' +
                 '<td><input type="text" class="form-control form-control-sm reporting-reason-input" ' +
                       'data-vb-key="' + escapeHtml(it.id) + '" ' +
                       'placeholder="reason not reported" value="' + reason + '" maxlength="200"></td>' +
                 '<td><button type="button" class="btn btn-sm btn-outline-secondary reporting-unexclude-btn" ' +
                       'data-vb-key="' + escapeHtml(it.id) + '" title="Remove from excluded list">&times;</button></td>' +
               '</tr>';
      }).join("");
      excludedTbody.innerHTML = html;
    }

    function renderCnvs(cnvs) {
      if (cnvs.length === 0) {
        cnvSection.style.display = "none";
        cnvList.innerHTML = "";
        return;
      }
      cnvSection.style.display = "";
      cnvCountBadge.textContent = String(cnvs.length);

      const html = cnvs.map(function (it, idx) {
        const s = it.snapshot || {};
        const caption = escapeHtml(window.tspipeReporting.getCnvCaption(it.id) || "");
        const label = escapeHtml(s.label || it.id);
        const path = escapeHtml(s.path || "");
        return '<div class="vb-cnv-report-card card mb-3" data-cnv-plot-id="' + escapeHtml(it.id) + '">' +
                 '<div class="card-header d-flex justify-content-between align-items-center py-2">' +
                   '<span class="fw-medium">' + (idx + 1) + '. ' + label + '</span>' +
                   '<button type="button" class="btn btn-sm btn-outline-secondary vb-cnv-remove" ' +
                     'data-cnv-plot-id="' + escapeHtml(it.id) + '" title="Remove from report">' +
                     "Remove</button>" +
                 '</div>' +
                 '<div class="card-body">' +
                   '<a href="./' + path + '" target="_blank" rel="noopener">' +
                     '<img src="./' + path + '" alt="' + label + '" ' +
                          'class="img-fluid border rounded vb-cnv-report-img" ' +
                          'style="display:block;width:100%;max-height:480px;object-fit:contain">' +
                   "</a>" +
                   '<label class="form-label mt-3 mb-1 small text-muted">' +
                     "Interpretation (editable, saved automatically)" +
                   "</label>" +
                   '<textarea class="form-control form-control-sm vb-cnv-caption-input" ' +
                     'data-cnv-plot-id="' + escapeHtml(it.id) + '" rows="2" ' +
                     'placeholder="e.g. Gain at 1q21 spanning RIT1 / BRINP3 consistent with chr1q duplication">' +
                     caption + "</textarea>" +
                 "</div>" +
               "</div>";
      }).join("");
      cnvList.innerHTML = html;
    }

    function render(items) {
      const all = items || window.tspipeReporting.load();
      const allVariants = all.filter(function (it) { return it.kind === "variant"; });
      const variants = allVariants.filter(function (it) { return (it.decision || "include") === "include"; });
      const excluded = allVariants.filter(function (it) { return it.decision === "exclude"; });
      const cnvs = all.filter(function (it) { return it.kind === "cnv_plot"; });
      const total = variants.length + excluded.length + cnvs.length;

      // Tab nav badge -- combined count of everything triaged
      if (tabBadge) {
        tabBadge.textContent = String(total);
        tabBadge.style.display = total ? "inline-block" : "none";
      }

      // Empty state vs sections
      if (total === 0) {
        emptyState.style.display = "";
        variantsSection.style.display = "none";
        excludedSection.style.display = "none";
        cnvSection.style.display = "none";
        copyBtn.disabled = true;
        clearBtn.disabled = true;
        return;
      }
      emptyState.style.display = "none";
      copyBtn.disabled = false;
      clearBtn.disabled = false;

      renderVariants(variants);
      renderExcluded(excluded);
      renderCnvs(cnvs);
    }

    function buildTsv() {
      const all = window.tspipeReporting.load();
      const allVariants = all.filter(function (it) { return it.kind === "variant"; });
      const variants = allVariants.filter(function (it) { return (it.decision || "include") === "include"; });
      const excluded = allVariants.filter(function (it) { return it.decision === "exclude"; });
      const cnvs = all.filter(function (it) { return it.kind === "cnv_plot"; });
      const sections = [];
      if (variants.length) {
        sections.push("# Variants");
        sections.push(VARIANT_COLUMNS.join("\t"));
        variants.forEach(function (it) { sections.push(variantRowToTsv(it)); });
      }
      if (excluded.length) {
        if (sections.length) sections.push("");  // blank separator line
        sections.push("# Excluded (reviewed, not reported)");
        sections.push(EXCLUDED_COLUMNS.join("\t"));
        excluded.forEach(function (it) { sections.push(excludedRowToTsv(it)); });
      }
      if (cnvs.length) {
        if (sections.length) sections.push("");  // blank separator line
        sections.push("# CNV findings");
        sections.push(CNV_COLUMNS.join("\t"));
        cnvs.forEach(function (it) { sections.push(cnvRowToTsv(it)); });
      }
      return sections.join("\n");
    }

    function showToast() {
      if (!toast) return;
      toast.classList.add("visible");
      setTimeout(function () { toast.classList.remove("visible"); }, 1500);
    }

    function copyTsv() {
      const text = buildTsv();
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(showToast).catch(function () {
          fallbackCopy(text); showToast();
        });
      } else {
        fallbackCopy(text); showToast();
      }
    }

    function fallbackCopy(text) {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand("copy"); } catch (e) {}
      document.body.removeChild(ta);
    }

    // Wire actions
    copyBtn.addEventListener("click", copyTsv);
    clearBtn.addEventListener("click", function () {
      if (confirm("Clear everything triaged (Include + Exclude variants and CNVs)? Tier values, exclude reasons, and CNV interpretation captions will also be cleared.")) {
        // Wipe tier values for all included/excluded variants
        window.tspipeReporting.load()
          .filter(function (it) { return it.kind === "variant"; })
          .forEach(function (it) {
            window.tspipeReporting.setTier(it.id, "");
            window.tspipeReporting.setExcludeReason(it.id, "");
          });
        // Wipe captions for all selected CNVs
        window.tspipeReporting.load()
          .filter(function (it) { return it.kind === "cnv_plot"; })
          .forEach(function (it) { window.tspipeReporting.setCnvCaption(it.id, ""); });
        window.tspipeReporting.clearAll();
      }
    });

    if (clearCnvBtn) {
      clearCnvBtn.addEventListener("click", function () {
        const cnvs = window.tspipeReporting.load()
          .filter(function (it) { return it.kind === "cnv_plot"; });
        if (!cnvs.length) return;
        if (confirm("Clear " + cnvs.length + " CNV plot selection(s)? Captions will also be cleared.")) {
          cnvs.forEach(function (it) {
            window.tspipeReporting.setCnvCaption(it.id, "");
            window.tspipeReporting.toggle("cnv_plot", it.id, it.snapshot);  // toggle off
          });
        }
      });
    }

    // ACMG/AMP Tier inline edits -- persist on input
    // DASH_LAYOUT_V1 (D4): the tier field is a textarea that grows with its text (wraps onto
    // further lines instead of scrolling out of view); Enter commits instead of inserting a
    // newline, and any newline is collapsed so the copied TSV stays one row per variant.
    function autosizeTier(el) {
      el.style.height = "auto";
      el.style.height = (el.scrollHeight + 2) + "px";
    }
    function autosizeAllTiers() {
      tbody.querySelectorAll(".reporting-tier-input").forEach(autosizeTier);
    }
    tbody.addEventListener("input", function (ev) {
      const inp = ev.target.closest(".reporting-tier-input");
      if (!inp) return;
      autosizeTier(inp);
      const key = inp.getAttribute("data-vb-key");
      window.tspipeReporting.setTier(key, inp.value.replace(/\s+/g, " ").trim());
    });
    tbody.addEventListener("keydown", function (ev) {
      if (ev.key === "Enter" && ev.target.closest(".reporting-tier-input")) {
        ev.preventDefault();
        ev.target.blur();
      }
    });

    // Up/down reorder of included variants. Mutating the store fires the
    // onChange -> render hook, which repaints the table with refreshed row
    // numbers and disabled states. The order persists for the TSV export and
    // for shared triage bundles. Disabled buttons do not emit click events.
    tbody.addEventListener("click", function (ev) {
      const up = ev.target.closest(".reporting-move-up");
      const down = ev.target.closest(".reporting-move-down");
      if (!up && !down) return;
      const key = (up || down).getAttribute("data-vb-key");
      window.tspipeReporting.move("variant", key, up ? -1 : 1);
    });

    // Exclude-reason inline edits -- persist on input. We do NOT re-render on
    // every keystroke (that would lose focus); the value is read live for TSV.
    excludedTbody.addEventListener("input", function (ev) {
      const inp = ev.target.closest(".reporting-reason-input");
      if (!inp) return;
      const key = inp.getAttribute("data-vb-key");
      window.tspipeReporting.setExcludeReason(key, inp.value);
    });

    // Un-exclude button -- return the variant to neutral (drops it from store).
    excludedTbody.addEventListener("click", function (ev) {
      const btn = ev.target.closest(".reporting-unexclude-btn");
      if (!btn) return;
      const key = btn.getAttribute("data-vb-key");
      window.tspipeReporting.setDecision("variant", key, "");  // clears reason too
    });

    // CNV interpretation textarea edits -- persist on input
    cnvList.addEventListener("input", function (ev) {
      const ta = ev.target.closest(".vb-cnv-caption-input");
      if (!ta) return;
      const id = ta.getAttribute("data-cnv-plot-id");
      window.tspipeReporting.setCnvCaption(id, ta.value);
    });

    // CNV "Remove" button -- toggle off the selection
    cnvList.addEventListener("click", function (ev) {
      const btn = ev.target.closest(".vb-cnv-remove");
      if (!btn) return;
      const id = btn.getAttribute("data-cnv-plot-id");
      const item = window.tspipeReporting.load().find(function (it) {
        return it.kind === "cnv_plot" && it.id === id;
      });
      if (item) {
        window.tspipeReporting.setCnvCaption(id, "");
        window.tspipeReporting.toggle("cnv_plot", id, item.snapshot);
      }
    });

    // Re-render on selection change
    window.tspipeReporting.onChange(render);

    // Initial render
    render();
  }

  // ---------------------------------------------------------------------------
  // CNV tab gallery: wire the "Include in report" checkboxes on each plot card.
  // ---------------------------------------------------------------------------
  function initCNVGallery() {
    const cnvTab = document.getElementById("tab-cnv");
    if (!cnvTab || !window.tspipeReporting) return;
    const countBadge = document.getElementById("cnv-selection-count-badge");

    function syncCheckboxes() {
      const selectedIds = new Set(
        window.tspipeReporting.load()
          .filter(function (it) { return it.kind === "cnv_plot"; })
          .map(function (it) { return it.id; })
      );
      cnvTab.querySelectorAll(".vb-cnv-select").forEach(function (box) {
        const id = box.getAttribute("data-cnv-plot-id");
        const shouldBe = selectedIds.has(id);
        if (box.checked !== shouldBe) box.checked = shouldBe;
      });
      if (countBadge) {
        countBadge.textContent = String(selectedIds.size);
        countBadge.style.display = selectedIds.size ? "inline-block" : "none";
      }
    }

    cnvTab.addEventListener("change", function (ev) {
      const box = ev.target.closest(".vb-cnv-select");
      if (!box) return;
      const card = box.closest(".vb-cnv-card");
      if (!card) return;
      const id = box.getAttribute("data-cnv-plot-id");
      const path = card.getAttribute("data-cnv-path") || "";
      const label = card.getAttribute("data-cnv-label") || id;
      window.tspipeReporting.toggle("cnv_plot", id, { path: path, label: label });
    });

    // Keep gallery checkboxes in sync with the store, e.g. when the Reporting
    // tab's "Clear CNV selections" or "Remove" buttons toggle items off.
    window.tspipeReporting.onChange(syncCheckboxes);

    // Initial sync (handles page reload with prior selections)
    syncCheckboxes();
  }

</script>
{% endblock %}
