/*
 * conf/twist_apply.config
 *
 * The complete twist_myeloid TSPIPE overlay. Load with -c alongside the
 * site profile; no per-panel CLI flags are then required:
 *
 *   nextflow run . --input samplesheet.csv --outdir <dir> \
 *       -profile gandalf,singularity -c conf/twist_apply.config
 *
 * Never load this file for the legacy myeloid/myeloid_cnv panels: it
 * repoints panel, BED, and CNV resources at the twist assets.
 *
 * NF 25.10 gotcha (verified 2026-09-01): -c files are compiled outside
 * the nextflow.config chain, so EAGER references to params defined there
 * (e.g. conda = params.legacy_python_env, mode: params.publish_dir_mode)
 * fail with "Unknown config attribute". Lazy closures like
 * path: { "${params.outdir}/..." } are fine. This file therefore uses
 * literals where the global config uses params.
 *
 * Version parity: the twist PoNs were built 2026-09-01 from the host
 * conda env (cnvkit 0.9.12, GATK 4.6.2.0; docs/audit/2026-09-01/). A PoN
 * must be applied with the version that built it, so CNVKIT and every
 * GATK_CNV_* process run with container = null here; tool resolution
 * comes from the site config's global beforeScript, which puts the
 * targeted-seq env bin on PATH for every process. All other modules keep
 * their containers, and the legacy panels are untouched because this
 * file is never loaded for them.
 */

params {
    panel              = 'twist_myeloid'
    panel_name         = 'Twist Myeloid TE-99430185'
    bed                = "${projectDir}/assets/twist_myeloid/panel.combined.filtered.bed"
    exonwise_bed       = "${projectDir}/assets/twist_myeloid/targets.exonwise.bed"

    // GATK CNV caller (TGC_V1): defining cnv_gatk_pon is the gate that
    // enables the GATK_CNV_CALLING block in workflows/tspipe.nf.
    cnv_gatk_pon       = "${projectDir}/assets/twist_myeloid/gatk_rc_pon_male.hdf5"
    cnv_gatk_intervals = "${projectDir}/assets/twist_myeloid/targets.preprocessed.interval_list"

    // BAF/cnLOH detector thresholds (BAF_V1; v1 heuristics, validation
    // on known del(17p)/cnLOH material pending)
    baf_min_depth      = 20
    baf_min_het_sites  = 10
    baf_f_min          = 0.10
    baf_cr_del         = -0.15
}

process {

    withName: 'CNVKIT' {
        // Host env for cnvkit 0.9.12 parity with PoN v2.1 (see header).
        container = null
        // PGC_ARG_V1: twist per-chromosome scatter pages (draft curation in
        // the TSV; genes label filenames only, scatters are chromosome-wide)
        ext.args  = "--panel-gene-chroms ${projectDir}/assets/twist_myeloid/panel_gene_chroms.tsv"
    }

    // TGC_V1: GATK CNV caller runs host-side for 4.6.2.0 parity with the
    // read-count PoN. Counts stay in work/ (intermediate); analysis-grade
    // outputs publish under <outdir>/<sample>/cnv_gatk/. mode 'link' is
    // the literal value of the global publish_dir_mode (see NF gotcha
    // above for why the param is not referenced here).
    withName: 'GATK_CNV_.*' {
        container = null
    }
    withName: 'GATK_CNV_DENOISE' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/cnv_gatk" },
            mode: 'link',
            pattern: '*CR.tsv'
        ]
    }
    withName: 'GATK_CNV_MODEL_SEGMENTS' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/cnv_gatk" },
            mode: 'link',
            pattern: '{*.seg,*.hets.tsv}'
        ]
    }
    withName: 'GATK_CNV_COLLECT_ALLELIC' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/cnv_gatk" },
            mode: 'link',
            pattern: '*.allelicCounts.tsv'
        ]
    }
    withName: 'CNV_BAF_CNLOH' {
        // BAF_V1: host env; verdicts/sites/plot under cnv_baf/
        container = null
        publishDir = [
            path: { "${params.outdir}/${meta.id}/cnv_baf" },
            mode: 'link',
            pattern: '*.baf17p.*'
        ]
    }
    withName: 'GATK_CNV_CALL_SEGMENTS' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/cnv_gatk" },
            mode: 'link',
            pattern: '*.called.seg'
        ]
    }
    withName: 'GATK_CNV_GENE_PROJECT' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/cnv_gatk" },
            mode: 'link',
            pattern: '*.{tsv,png}'
        ]
    }
}
