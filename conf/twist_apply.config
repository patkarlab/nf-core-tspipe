/*
 * conf/twist_apply.config
 *
 * Load with -c for twist_myeloid TSPIPE application runs only, alongside
 * the site profile:
 *
 *   nextflow run . --panel twist_myeloid ... \
 *       -profile gandalf,singularity -c conf/twist_apply.config
 *
 * Rationale: the twist male PoN (v2.1) was built with cnvkit 0.9.12 from
 * the host conda env (see conf/twist_pon_noncontainer.config and
 * docs/audit/2026-09-01/). A PoN must be applied with the version that
 * built it. The CNVKIT module pins a cnvkit 0.9.10 container, which is
 * correct for the legacy myeloid/myeloid_cnv panels (their PoNs were
 * built at 0.9.10) and wrong for twist. This override runs ONLY the
 * CNVKIT process on the host env; every other module keeps its container,
 * and the legacy panels are untouched because this file is never loaded
 * for them.
 *
 * Host tool resolution: conf/gandalf.config exports the targeted-seq env
 * bin onto PATH for every process (beforeScript), so cnvkit 0.9.12 and
 * its pandas/matplotlib stack resolve without a conda directive being
 * strictly required; the conda line below is belt-and-braces for
 * conda-enabled profiles.
 */

process {
    withName: 'CNVKIT' {
        container = null
        conda     = params.legacy_python_env
        // PGC_ARG_V1: twist per-chromosome scatter pages (draft curation in
        // the TSV; genes label filenames only, scatters are chromosome-wide)
        ext.args  = "--panel-gene-chroms ${projectDir}/assets/twist_myeloid/panel_gene_chroms.tsv"
    }
}
