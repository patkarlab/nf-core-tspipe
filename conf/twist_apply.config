/*
 * conf/twist_apply.config
 *
 * The complete twist_myeloid TSPIPE overlay. Load with -c alongside the
 * site profile; no per-panel CLI flags are then required:
 *
 *   nextflow run . --input samplesheet.csv --outdir <dir> \
 *       -profile gandalf,singularity -c conf/twist_apply.config
 *
 * Never load this file for the legacy myeloid/myeloid_cnv panels: it
 * repoints panel, BED, and CNV resources at the twist assets.
 *
 * NF 25.10 gotcha (verified 2026-09-01): -c files are compiled outside
 * the nextflow.config chain, so EAGER references to params defined there
 * (e.g. conda = params.legacy_python_env, mode: params.publish_dir_mode)
 * fail with "Unknown config attribute". Lazy closures like
 * path: { "${params.outdir}/..." } are fine. This file therefore uses
 * literals where the global config uses params.
 *
 * Version parity: the twist PoNs were built 2026-09-01 from the host
 * conda env (cnvkit 0.9.12, GATK 4.6.2.0; docs/audit/2026-09-01/). A PoN
 * must be applied with the version that built it, so CNVKIT and every
 * GATK_CNV_* process run with container = null here; tool resolution
 * comes from the site config's global beforeScript, which puts the
 * targeted-seq env bin on PATH for every process. All other modules keep
 * their containers, and the legacy panels are untouched because this
 * file is never loaded for them.
 */

params {
    panel              = 'twist_myeloid'
    panel_name         = 'Twist Myeloid TE-99430185'
    bed                = "${projectDir}/assets/twist_myeloid/panel.combined.filtered.bed"
    exonwise_bed       = "${projectDir}/assets/twist_myeloid/targets.exonwise.bed"

    // GATK CNV caller (TGC_V1): defining cnv_gatk_pon is the gate that
    // enables the GATK_CNV_CALLING block in workflows/tspipe.nf.
    cnv_gatk_pon       = "${projectDir}/assets/twist_myeloid/gatk_rc_pon_male.hdf5"
    cnv_gatk_pon_female = "${projectDir}/assets/twist_myeloid/gatk_rc_pon_female.hdf5"   // MARKER SEXSTRAT_V1
    cnv_gatk_intervals = "${projectDir}/assets/twist_myeloid/targets.preprocessed.interval_list"

    // BAF/cnLOH detector thresholds (BAF_V1; v1 heuristics, validation
    // on known del(17p)/cnLOH material pending)
    baf_min_depth      = 20
    baf_min_het_sites  = 10
    baf_f_min          = 0.10
    baf_cr_del         = -0.15

    // PureCN (PCN_V1): dedicated conda env (PureCN 2.16.0,
    // envs/purecn.environment.yml); literals per the -c eager-params
    // gotcha. Reference set built by tools/build_purecn_normaldb.sh.
    purecn_extdata     = '/home/hemat/anaconda3/envs/purecn/lib/R/library/PureCN/extdata'
    purecn_intervals   = "${projectDir}/assets/twist_myeloid/purecn_intervals_twist_myeloid_hg38.txt"
    purecn_normaldb    = "${projectDir}/assets/twist_myeloid/normalDB_twist_myeloid_hg38.rds"
    purecn_normaldb_female = "${projectDir}/assets/twist_myeloid/normalDB_twist_myeloid_female_hg38.rds"   // MARKER PCN_SEX_V1
    // MARKER DECON_V1: exon-level arm E (DECoN/ExomeDepth); defining decon_pool_male is
    // the gate. Pools from tools/decon/build_decon_pool.sh --sex male|female.
    decon_pool_male    = "${projectDir}/assets/twist_myeloid/decon_pool_male.RData"
    decon_pool_female  = "${projectDir}/assets/twist_myeloid/decon_pool_female.RData"
    decon_exons_bed    = "${projectDir}/assets/twist_myeloid/decon_exons.bed"
    decon_trans_prob   = 0.01
    decon_min_corr     = 0.98
    decon_min_cov      = 100
    decon_bf           = 12
    decon_del_multi_bf = 8    // MARKER DECON_V1b: deletions of >= 2 exons report at this BF
    // MARKER EXON_PLOTS_V1: exon-level figures; DECoN calls at or above this BF are drawn
    exon_plot_min_bf   = 5
    // MARKER HMF_PURPLE_V1: hmftools stack (AMBER 4.3 / COBALT 3.0 / PURPLE 4.4 in the host env
    // 'hmftools'); defining hmf_resources is the gate, the normalisation asset must exist.
    hmf_env           = '/home/hemat/anaconda3/envs/hmftools'
    hmf_resources     = '/goast/hemat_data/references/hmftools/hmf_pipeline_resources.38_v3.0.0--8'
    hmf_loci          = '/goast/hemat_data/references/hmftools/hmf_pipeline_resources.38_v3.0.0--8/dna/copy_number/AmberGermlineSites.38.tsv.gz'
    hmf_gc_profile    = '/goast/hemat_data/references/hmftools/hmf_pipeline_resources.38_v3.0.0--8/dna/copy_number/GC_profile.1000bp.38.cnp'
    hmf_ensembl_dir   = '/goast/hemat_data/references/hmftools/hmf_pipeline_resources.38_v3.0.0--8/common/ensembl_data'
    hmf_hotspots      = '/goast/hemat_data/references/hmftools/hmf_pipeline_resources.38_v3.0.0--8/dna/variants/KnownHotspots.somatic.38.vcf.gz'
    hmf_target_bed    = "${projectDir}/assets/twist_myeloid/hmftools/target_regions.twist_myeloid.38.bed"
    hmf_target_norm   = "${projectDir}/assets/twist_myeloid/hmftools/target_regions.cobalt_normalisation.twist_myeloid.38.tsv"
    hmf_driver_panel  = "${projectDir}/assets/twist_myeloid/hmftools/DriverGenePanel.twist_myeloid.38.tsv"
    hmf_pcf_gamma     = 50
}

process {

    withName: 'CNVKIT' {
        // Host env for cnvkit 0.9.12 parity with PoN v2.1 (see header).
        container = null
        // PGC_ARG_V1: twist per-chromosome scatter pages (draft curation in
        // the TSV; genes label filenames only, scatters are chromosome-wide)
        ext.args  = "--panel-gene-chroms ${projectDir}/assets/twist_myeloid/panel_gene_chroms.tsv"
    }

    // TGC_V1: GATK CNV caller runs host-side for 4.6.2.0 parity with the
    // read-count PoN. Counts stay in work/ (intermediate); analysis-grade
    // outputs publish under <outdir>/<sample>/cnv_gatk/. mode 'link' is
    // the literal value of the global publish_dir_mode (see NF gotcha
    // above for why the param is not referenced here).
    withName: 'GATK_CNV_.*' {
        container = null
    }
    withName: 'GATK_CNV_DENOISE' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/cnv_gatk" },
            mode: 'link',
            pattern: '*CR.tsv'
        ]
    }
    withName: 'GATK_CNV_MODEL_SEGMENTS' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/cnv_gatk" },
            mode: 'link',
            pattern: '{*.seg,*.hets.tsv}'
        ]
    }
    withName: 'GATK_CNV_COLLECT_ALLELIC' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/cnv_gatk" },
            mode: 'link',
            pattern: '*.allelicCounts.tsv'
        ]
    }
    // PCN_V1: PureCN processes run on the dedicated purecn env. The
    // beforeScript override replaces the site-wide targeted-seq PATH
    // export for these two processes only (they need Rscript, nothing
    // else); literal path per the -c eager-params gotcha.
    withName: 'PURECN.*' {
        container    = null
        beforeScript = 'export PATH=/home/hemat/anaconda3/envs/purecn/bin:$PATH'
    }
    withName: 'PURECN' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/purecn" },
            mode: 'link',
            pattern: '{*.csv,*.pdf,*.rds,*_dnacopy.seg,*.purecn.*.tsv,*.purecn.log}'
        ]
    }
    // DECON_V1: DECoN on the host 'decon' env (r-base 4.3, ExomeDepth 1.1.16);
    // targeted-seq kept on PATH for python3. Literal paths per the -c
    // eager-params gotcha.
    withName: 'DECON' {
        container    = null
        beforeScript = 'export PATH=/home/hemat/anaconda3/envs/decon/bin:/home/hemat/anaconda3/envs/targeted-seq/bin:$PATH'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/cnv_decon" },
            mode: 'copy',
            // MARKER PUBLISH_CLINICAL_V2: sample-level, outside the main.nf sweep list; moves under clinical/ when ORGANIZE_OUTPUT routes it (item 12)
            pattern: '*.decon*'
        ]
    }
    // EXON_PLOTS_V1: exon-level figures beside the consensus (GATK container: py3.6 + matplotlib)
    withName: 'EXON_PLOTS' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/cnv_consensus_multi" },
            mode: 'copy',
            pattern: 'exon_plots'
        ]
    }
    // HMF_PURPLE_V1: hmftools on the host 'hmftools' env (Java 21); targeted-seq kept for python3
    withName: 'HMF_.*' {
        container    = null
        beforeScript = 'export PATH=/home/hemat/anaconda3/envs/hmftools/bin:/home/hemat/anaconda3/envs/targeted-seq/bin:$PATH'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/cnv_hmftools" },
            mode: 'copy',
            pattern: '{amber,cobalt,purple,*.purple.h_*.tsv,*.log}'
        ]
    }
    // MARKER CHROM_PAGES_V1: chromosome pages beside the consensus (GATK container: py3.6 + matplotlib)
    withName: 'CHROM_PAGES' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/cnv_consensus_multi" },
            mode: 'copy',
            pattern: 'chrom_pages'
        ]
    }
    withName: 'CNV_CONSENSUS_MULTI' {
        // CMX_V1: four-caller consensus + Phase-4 JSON
        container = null
        publishDir = [
            path: { "${params.outdir}/${meta.id}/cnv_consensus_multi" },
            mode: 'copy',
            // MARKER PUBLISH_CLINICAL_V2: sample-level, outside the main.nf sweep list; moves under clinical/ when ORGANIZE_OUTPUT routes it (item 12)
            pattern: '*.cnv_consensus4.*'
        ]
    }
    withName: 'CNV_BAF_CNLOH' {
        // BAF_V1: host env; verdicts/sites/plot under cnv_baf/
        container = null
        publishDir = [
            path: { "${params.outdir}/${meta.id}/cnv_baf" },
            mode: 'link',
            pattern: '*.baf17p.*'
        ]
    }
    withName: 'GATK_CNV_CALL_SEGMENTS' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/cnv_gatk" },
            mode: 'link',
            pattern: '*.called.seg'
        ]
    }
    withName: 'GATK_CNV_GENE_PROJECT' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/cnv_gatk" },
            mode: 'link',
            pattern: '*.{tsv,png}'
        ]
    }
}
