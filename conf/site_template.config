/*
 * conf/site_template.config -- starting point for a server's own profile (MARKER PORTABLE_V1)
 *
 * Installing on a further server needs no change to any tracked file:
 *
 *   1. Copy this file to conf/site.config (git-ignored), or keep it anywhere else and name it:
 *          export TSPIPE_SITE_CONFIG=/path/to/mysite.config
 *   2. Set site_root below, and adjust the lines that differ on your server.
 *   3. Check the installation (images, references, checksums against the release manifest):
 *          bash tools/verify_install.sh -profile site,singularity -c conf/twist_apply.config
 *   4. Run:
 *          nextflow run . -profile site,singularity -c conf/twist_apply.config \
 *              --input <samplesheet.csv> --outdir <output directory> -w <work directory>
 *
 * The `site` profile of nextflow.config reads this file and then conf/containers.config, which
 * assigns the container image and the in-image tool paths to every process; do not include it here.
 *
 * What belongs in a site profile: where things are (paths), how tasks are executed (executor,
 * queues, resource ceilings) and how the container runtime reaches the data (cache directory,
 * bind mounts). Nothing else. Calling and filtering thresholds, tool arguments and the panel
 * definition live in conf/modules.config, the panel overlay and assets/, and are identical on every
 * site (SOP-TSPIPE-001 section 11). The panel BEDs, panels of normals, blacklist, CAVA catalog and
 * every other panel asset come from the checkout itself and need no entry here.
 *
 * The directory layout below is a suggestion; only the paths matter. SOP-TSPIPE-001 sections 6.5
 * and 7.6 list the reference data, docs/release/reference_manifest.tsv their sizes and checksums.
 */

params {
    // ---- the one line most sites change -------------------------------------------------------
    site_root          = '/path/to/tspipe_site'

    // ---- reference genome: masked GRCh38 with its .fai, .dict, .alt and bwa-mem2 index beside it
    reference          = "${params.site_root}/references/hg38_broad/Homo_sapiens_assembly38.masked.fasta"
    adapters           = "${params.site_root}/references/adapters/illumina_adapters.fa"

    // ---- Broad bundle: known sites for BQSR, gnomAD for Mutect2 (each with its .tbi) ----------
    dbsnp_vcf          = "${params.site_root}/references/dbSNPGATK_hg38/Homo_sapiens_assembly38.dbsnp138.vcf.gz"
    mills_vcf          = "${params.site_root}/references/dbSNPGATK_hg38/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
    gnomad_af_only     = "${params.site_root}/references/dbSNPGATK_hg38/af-only-gnomad.hg38.vcf.gz"

    // ---- annotation data (the ANNOVAR program itself is inside the image) ---------------------
    vep_cache          = "${params.site_root}/references/vep_cache"
    annovar_db         = "${params.site_root}/references/annovar/humandb"

    // ---- hmftools resource bundle: AMBER, COBALT and PURPLE find their reference files under it
    hmf_root           = "${params.site_root}/references/hmftools/hmf_pipeline_resources.38_v3.0.0--8"

    // ---- VariantValidator: the public service, with a response cache on storage every run shares
    vv_url             = 'https://rest.variantvalidator.org'
    vv_cache_dir       = "${params.site_root}/vv_cache"

    // ---- FLT3 ensemble runtime: the container engine in use ('singularity' also for Apptainer)
    flt3_container     = 'singularity'

    // ---- resource ceilings: no more than one node can give, or a task is never scheduled -------
    // conf/base.config clamps every request at these.
    max_cpus           = 16
    max_memory         = '128.GB'
    max_time           = '72.h'

    // ---- 'copy' when the work directory and the output directory are on different filesystems,
    //      or on a filesystem without hard links (the default, 'link', then silently copies or fails)
    // publish_dir_mode = 'copy'
}

// ---------------------------------------------------------------------------------------------
// Execution
// ---------------------------------------------------------------------------------------------
// A single server: everything runs on the machine Nextflow is started on.
process.executor = 'local'
executor {
    $local {
        cpus      = 16
        memory    = '128 GB'
        queueSize = 8
    }
}

// A cluster: replace the block above with the scheduler, and keep the steps that reach the internet
// or only assemble reports on the node Nextflow runs on. That node needs outbound HTTPS
// (VariantValidator, GeneBe, MobiDetails, CancerVar, OncoKB); a compute node without it produces
// reports with silently empty annotation sections (SOP section 6.3). conf/clinical23.config is a
// worked PBS Pro example.
//
// process {
//     executor = 'slurm'            // or 'pbspro', 'sge', ...
//     queue    = 'normal'
//     // beforeScript = 'export PATH=/path/to/apptainer/bin:$PATH'   // only if the runtime is not on PATH in a batch job
//     withName: 'VARIANT_VALIDATOR' { executor = 'local'; maxForks = 1; cpus = 2; memory = '8.GB' }
//     withName: 'DASHBOARD|REPORT_BUNDLE|RUN_BUNDLE|ORGANIZE_OUTPUT' { executor = 'local'; cpus = 4; memory = '16.GB' }
// }
// executor {
//     queueSize = 16
//     $local { cpus = 16; memory = '64 GB'; queueSize = 4 }   // must fit the largest local request above
// }
// Do not put a resource request in clusterOptions: Nextflow then omits its own and tasks run with
// the scheduler's defaults (SOP section 7.8).

// ---------------------------------------------------------------------------------------------
// Container runtime
// ---------------------------------------------------------------------------------------------
// cacheDir holds the images of docs/release/image_checksums.md5 under the names listed there
// (.sif files, or sandbox directories from tools/make_sandboxes.sh where compute nodes cannot mount
// a .sif). runOptions must bind every directory a task reads or writes: the reference tree, the
// FASTQ location, the work directory and the output directory. --no-home keeps a task from picking
// up anything in the user's home directory.
singularity {
    enabled     = true
    autoMounts  = true
    cacheDir    = "${params.site_root}/images"
    pullTimeout = '60m'
    runOptions  = "--no-home -B ${params.site_root}"
}
docker {
    enabled = false
}
