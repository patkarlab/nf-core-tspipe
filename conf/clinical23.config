/*
 * conf/clinical23.config
 *
 * Site profile for clinical-23 (PBS Pro cluster, login node ln1), written for the v1.0.0 freeze.
 * Companion to conf/gandalf.config: the same pipeline, the same images, different paths, executor
 * and container runtime. Include conf/containers.config last, as gandalf.config does.
 *
 * Usage (from ln1, NOT as a PBS job -- see "head node" below):
 *     nextflow run . -profile clinical23,singularity \
 *         --input <samplesheet.csv> --outdir /scratch/patkarlab-clinical/<run> \
 *         -c conf/twist_apply.config
 *
 * Facts this profile is built on (probed 2026-09-10):
 *
 *   head node    ln1 has Apptainer 1.5.1, Nextflow 25.10.4, Java, and internet access. Compute
 *                nodes have NO internet and cannot resolve external names. DASHBOARD (GeneBe,
 *                MobiDetails, CancerVar, OncoKB) and VARIANT_VALIDATOR carry `executor 'local'`,
 *                so they run wherever Nextflow runs: the head process must be started on ln1 with
 *                setsid/nohup, not submitted to a queue. A run of 2026-09-09 whose head process sat
 *                on a compute node produced reports with empty GeneBe and MobiDetails sections.
 *
 *   apptainer    /soft/apptainer/1.5.1/bin/apptainer is reachable on every node (Lustre /soft);
 *                `module load apptainer/1.5.1` does not reliably work in a batch shell, so PATH is
 *                exported in beforeScript instead.
 *
 *   image form   compute nodes have no squashfuse, so Apptainer cannot mount a .sif and would
 *                extract it into /tmp for every task (this wedged cn001 on 2026-08-30). Images are
 *                therefore SANDBOX DIRECTORIES on Lustre, created by tools/make_sandboxes.sh, each
 *                carrying the same `<name>.img` name Nextflow expects in the cache directory.
 *                If the admins install squashfuse, point cacheDir at a directory of .sif files
 *                instead and nothing else changes.
 *
 *   storage      Lustre: /home/patkarlab-clinical (references, repo), /scratch (work dir, outputs,
 *                images). --no-home is set, so every path a task touches must be bound below.
 */

params {
    // ---------------------------------------------------------------------
    // Roots. Override on the command line or in params.yaml if you move data.
    // ---------------------------------------------------------------------
    pipeline_root      = '/home/patkarlab-clinical'
    ref_root           = '/home/patkarlab-clinical/references'
    release_root       = '/scratch/patkarlab-clinical/tspipe_release'

    // References (masked GRCh38; the .alt must sit beside the FASTA -- see verify_install.sh)
    reference          = "${params.ref_root}/hg38_broad/Homo_sapiens_assembly38.masked.fasta"
    adapters           = "${params.ref_root}/adapters/illumina_adapters.fa"
    dbsnp_vcf          = "${params.ref_root}/dbSNPGATK_hg38/Homo_sapiens_assembly38.dbsnp138.vcf.gz"
    mills_vcf          = "${params.ref_root}/dbSNPGATK_hg38/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
    gnomad_af_only     = "${params.ref_root}/dbSNPGATK_hg38/af-only-gnomad.hg38.vcf.gz"

    // Annotation. The ANNOVAR tables under programs/annovar/humandb are the set validated on
    // gandalf (clinvar_20220320, cosmic103, gnomad211_exome, avsnp150, refGene); the newer tables
    // under references/humandb are for the ClinVar refresh (A7), not for this release.
    vep_cache          = "${params.ref_root}/vep_cache"
    annovar_script     = "${params.pipeline_root}/programs/annovar/table_annovar.pl"
    annovar_db         = "${params.pipeline_root}/programs/annovar/humandb"

    // VariantValidator: public API as on gandalf, with the response cache on shared storage so a
    // repeated variant never costs a second request. maxForks 1 is set below.
    vv_url             = 'https://rest.variantvalidator.org'
    vv_cache_dir       = "${params.release_root}/vv_cache"

    // Panel defaults (MYOPOOL). A Twist run adds -c conf/twist_apply.config, which overrides these
    // and supplies the CNV assets.
    // MARKER PANEL_ASSETS_V1: panel BEDs come from assets/myeloid/ in the repository.
    pindel_bed         = "${projectDir}/references/pindel_targets_flt3_ubtf.bed"
    snv_blacklist      = "${projectDir}/references/blacklist_file.tsv"

    // hmftools resource bundle (transferred from gandalf; see the reference manifest)
    // The hmftools reference paths are hardcoded to the development host in
    // conf/twist_apply.config and cannot be overridden from here: a -c overlay is merged after
    // this profile. They are set in params_clinical23.yaml, which takes precedence over both.
    // tools/launch_clinical23.sh always passes it; a run without it fails at AMBER.

    // FLT3 ensemble runtime
    flt3_container     = 'singularity'

    // Resource ceiling: compute nodes are 56 cpus / 250 GB. process_high asks for 64 cpus and
    // 256 GB in conf/base.config, which would never be schedulable here.
    max_cpus           = 48
    max_memory         = '200.GB'
    max_time           = '72.h'

    publish_dir_mode   = 'copy'
}

// ---------------------------------------------------------------------------
// Execution: PBS Pro for compute, local (ln1) for the network-bound steps
// ---------------------------------------------------------------------------
process {
    executor   = 'pbspro'
    queue      = 'medium'

    // Apptainer is not on PATH in a batch shell; the module load is unreliable, the path is not.
    beforeScript = 'export PATH=/soft/apptainer/1.5.1/bin:$PATH'

    withLabel: process_low { queue = 'short' }

    // Steps that reach the internet or the local filesystem only; they run on ln1 with the head
    // process. Do not give these a queue.
    // These run on ln1 beside the head process, so their resource requests must fit the
    // executor.$local pool below -- a process asking for 24 cpus there aborts the run. They are
    // light: the validator is one thread against a serial API, the rest are report assembly.
    withName: 'VARIANT_VALIDATOR' {
        executor = 'local'
        maxForks = 1          // the public VariantValidator API answers one request at a time
        cpus     = 2
        memory   = '8.GB'
    }
    withName: 'DASHBOARD|REPORT_BUNDLE|RUN_BUNDLE|ORGANIZE_OUTPUT' {
        executor = 'local'
        cpus     = 4
        memory   = '16.GB'
    }
    withName: 'DEEPSOMATIC' {
        time   = '6.h'
        memory = '32.GB'
    }
}

executor {
    $pbspro {
        queueSize      = 16
        submitRateLimit = '50/1min'
        exitReadTimeout = '30 min'
    }
    $local {
        cpus      = 16
        memory    = '64 GB'
        queueSize = 4
    }
}

// ---------------------------------------------------------------------------
// Containers: Apptainer, sandbox directories on Lustre
// ---------------------------------------------------------------------------
singularity {
    enabled     = true
    autoMounts  = true
    cacheDir    = "${params.release_root}/sandboxes"
    pullTimeout = '60m'
    // --no-home keeps a task from picking up anything in the user's home; every path a task reads
    // or writes is bound explicitly. /soft carries the apptainer install itself.
    runOptions  = '--no-home -B /home/patkarlab-clinical -B /scratch -B /soft'
}
docker {
    enabled = false
}

// Containers and per-process PATH for every process that used to run on a conda environment.
// Must come last so it wins over the blocks above.
includeConfig 'containers.config'

// conf/modules.config pins VARIANT_VALIDATOR, ONCOVI and FLT3_TO_VARIANTS to `executor 'local'`
// (a gandalf-era choice: they ran outside a container there) and it is included AFTER the site
// profile, so this override has to come last of all. Only the validator needs the internet; the
// other two are local-file work and belong on the cluster, where their 24-cpu request can be met.
process {
    withName: 'ONCOVI|FLT3_TO_VARIANTS' {
        executor = 'pbspro'
        queue    = 'medium'
    }
}
