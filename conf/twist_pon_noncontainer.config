/*
 * conf/twist_pon_noncontainer.config
 *
 * Override for the twist_myeloid PoN build only. Loaded with -c, never as a
 * profile, so nothing else is affected.
 *
 * conf/gandalf.config enables singularity, which would run cnvkit 0.9.10 and
 * GATK 4.5.0.0 from the container images. This PoN is applied on clinical-23,
 * where scoring uses the conda env: cnvkit 0.9.12, GATK 4.6.2.0. A PoN must be
 * built with the same versions that score against it, so containers are
 * disabled here and tools come from the conda env on both machines.
 *
 * Verified 2026-08-31: cnvkit 0.9.12 and GATK 4.6.2.0 on gandalf and
 * clinical-23; all preprocessing and PoN module files md5-identical.
 */

singularity.enabled = false
docker.enabled      = false

process {
    beforeScript = 'export PATH=/home/hemat/anaconda3/envs/targeted-seq/bin:$PATH'
}
