/*
 * conf/containers.config -- MARKER CONTAINERS_V1 (FREEZE A1)
 *
 * Every process that ran on a gandalf conda environment now runs on local/tspipe-host:v1.1
 * (containers/tspipe-host/), which carries those environments unpacked at /opt/envs/<name> and
 * the external installs under /opt/. Included last from every site profile; never load it alone.
 *
 * Per-process PATH is set with --env (Docker, Singularity >= 3.6, Apptainer): a beforeScript
 * export does not reach a Docker container, and under Singularity PATH is the one host variable
 * that is not inherited. The order is what the process had on gandalf. The strings are written
 * out in full on purpose: a helper closure here is resolved at run time but not by `nextflow
 * config`, which made the profile unverifiable.
 */

params {
    // Environments and installs inside the image (these supersede the host defaults in
    // nextflow.config and the site profiles, which is why this file is included last).
    legacy_python_env = '/opt/envs/targeted-seq'
    dashboard_python  = '/opt/envs/targeted-seq/bin/python'
    oncovi_dir        = '/opt/oncovi'
    annovar_script    = '/opt/annovar/table_annovar.pl'
    purecn_extdata    = '/opt/envs/purecn/lib/R/library/PureCN/extdata'
    hmf_env           = '/opt/envs/hmftools'
    reconcnv_env      = '/opt/envs/reconCNV'
}

process {
    // targeted-seq first: aligners, callers, GATK CNV, consensus, python tooling, host-side reporting
    withName: 'BWA_MEM|ABRA2|FREEBAYES|VARDICT|VARSCAN|PINDEL|VEP_ANNOTATE|VARIANT_FILTER|U2AF1_RESCUE|CNVKIT|GATK_CNV_.*|CNV_BAF_CNLOH|CNV_CONSENSUS_MULTI|DASHBOARD|REPORT_BUNDLE|RUN_BUNDLE|VARIANT_VALIDATOR|ONCOVI|FLT3_TO_VARIANTS|BPT_.*' {
        container        = 'local/tspipe-host:v1.1'
        containerOptions = '--env PATH=/opt/envs/targeted-seq/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    }
    // py2 first: Strelka2 and Platypus
    withName: 'STRELKA|PLATYPUS' {
        container        = 'local/tspipe-host:v1.1'
        containerOptions = '--env PATH=/opt/envs/py2/bin:/opt/envs/targeted-seq/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    }
    withName: 'STRELKA' {
        ext.python2     = 'python2'
        ext.strelka_bin = '/opt/strelka2/bin/configureStrelkaGermlineWorkflow.py'
    }
    withName: 'VARDICT' {
        ext.vardict_helpers_dir = '/opt/vardict/bin'
    }
    withName: 'PURECN.*' {
        container        = 'local/tspipe-host:v1.1'
        containerOptions = '--env PATH=/opt/envs/purecn/bin:/opt/envs/targeted-seq/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    }
    withName: 'DECON' {
        container        = 'local/tspipe-host:v1.1'
        containerOptions = '--env PATH=/opt/envs/decon/bin:/opt/envs/targeted-seq/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    }
    withName: 'HMF_.*' {
        container        = 'local/tspipe-host:v1.1'
        containerOptions = '--env PATH=/opt/envs/hmftools/bin:/opt/envs/targeted-seq/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    }
    withName: 'RECONCNV' {
        container        = 'local/tspipe-host:v1.1'
        containerOptions = '--env PATH=/opt/envs/reconCNV/bin:/opt/envs/targeted-seq/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    }
}
