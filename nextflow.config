/*
 * nf-core-tspipe nextflow.config
 *
 * Parameter defaults mirror run_sample_pipeline.py:
 *   - reference     -> --reference
 *   - bed           -> --bed
 *   - input         -> samplesheet replacing --fastq-dir + sample discovery
 *   - cnv_pon       -> --pon
 *   - cnv_loo_*     -> --loo-summary, --noise-profile
 *   - snv_blacklist -> --blacklist-snvs
 */

params {
    // ---- Input -----------------------------------------------------------
    input              = null   // samplesheet CSV (see assets/schema_input.json)
    outdir             = "${launchDir}/results"   // MARKER PORTABLE_V1: no site path as a default; pass --outdir (a site profile may set its own default)
    keep_intermediates = false
    panel_name         = "MYOPOOL hg38"

    // ---- Reference / panel ----------------------------------------------
    reference          = null   // hg38 masked FASTA
    panel              = 'myeloid'   // panel name; drives references/<panel>/ output namespacing
    male_reference     = true        // pass -y to cnvkit (haploid X reference); set false for female-only PoN
    chrx_threshold     = null        // chrX log2 cutoff for BUILD_SEX_PON sex classification;
                                     // null => derived from male_reference (+0.5 if -y, else -0.5)
    bed                = "${projectDir}/assets/myeloid/MYOPOOL_240125_UBTF_hg38.bed"   // MARKER PANEL_ASSETS_V1: panel definition lives in the repository, not a site path
    exonwise_bed       = "${projectDir}/assets/myeloid/MYOPOOL_240125_UBTF_Exonwise_hg38.bed"   // MARKER PANEL_ASSETS_V1: panel definition lives in the repository, not a site path
    igv_gene_track     = null   // IGV_V2B: annotation track (BED/GTF) under the reads in the IGV report; exonwise_bed when unset
    pindel_bed         = "${projectDir}/references/pindel_targets_flt3_ubtf.bed"   // PORTABLE_V1: a file of the checkout (FLT3 / UBTF Pindel targets), the value both site profiles set; was null here, and the workflow requires it
    adapters           = null   // illumina_adapters.fa

    // ---- CNV resources --------------------------------------------------
    // nf-core CNV wiring v1 (apply_nfcore_cnv_wiring_part1)
    cnv_pon            = null   // DEPRECATED: mixed-sex PoN. Kept for back-
                                //   compat; ignored when meta.sex is set.
    cnv_pon_male       = null   // assets/${panel}/cnvkit_pon_male.cnn fallback
    cnv_pon_female     = null   // assets/${panel}/cnvkit_pon_female.cnn fallback
    cnv_loo_summary    = null   // assets/${panel}/cnvkit_loo_summary.tsv fallback
    cnv_noise_profile  = null   // assets/${panel}/loo_bin_noise_profile.tsv fallback
    cnv_noisy_bins     = null   // assets/${panel}/cnvkit_noisy_bins.bed fallback
    // MARKER SEXSTRAT_V1: female-stratum LOO artefacts (male file used when a panel has none)
    cnv_loo_summary_female = null   // assets/${panel}/cnvkit_loo_summary_female.tsv fallback
    cnv_noisy_bins_female  = null   // assets/${panel}/cnvkit_noisy_bins_female.bed fallback
    cnv_sex_fallback       = 'male' // stratum for samples whose meta.sex is not male/female

    // ---- Annotation references -----------------------------------------
    cytoband           = null   // assets/references/cytoBand_hg38.txt fallback
    clingen            = null   // assets/references/ClinGen_gene_curation_list_GRCh38.tsv fallback

    // ---- Blacklist ------------------------------------------------------
    snv_blacklist      = "${projectDir}/references/blacklist_file.tsv"   // 11-column schema; matcher in bin/apply_blacklist.py

    // ---- Annotation -----------------------------------------------------
    vep_cache          = null
    annovar_script     = null   // path to ANNOVAR's table_annovar.pl
    annovar_db         = null
    // CAVA_V1c (N3): CAVA 2.0.15 transcript catalog + config template (assets, tracked in git)
    cava_catalog       = "${projectDir}/assets/cava/mane-1.5-grch38-refseq"
    cava_config        = "${projectDir}/assets/cava/cava_config.template.txt"

    // ---- Environments and installs inside local/tspipe-host --------------
    // MARKER PORTABLE_V1. VARIANT_VALIDATOR, ONCOVI, FLT3_TO_VARIANTS and DASHBOARD call the python of
    // the targeted-seq environment by path. Since CONTAINERS_V1 that environment is inside the image,
    // so the defaults are the in-image paths; conf/containers.config sets the same values. They were
    // paths under /home/hemat on the development host, which every other site inherited unless its
    // profile happened to include conf/containers.config. legacy_root is no longer read by any process
    // and is kept, unset, only so that an old site file naming it still parses.
    legacy_root        = null
    legacy_python_env  = '/opt/envs/targeted-seq'
    // ---- VariantValidator endpoint (MARKER vv_public, 2026-09-03) ----
    // Public REST service by default (1-2 s per variant, no local stack).
    // Set to http://localhost:5001 to use the Docker stack (see
    // docs/sops/vv_troubleshooting.md). vv_cache_dir caches responses per
    // VV version; null disables the cache.
    vv_url             = 'https://rest.variantvalidator.org'
    vv_cache_dir       = null
    // OncoVI third-party install (engine in src/, data in resources/): inside the image, like
    // ANNOVAR and Strelka2 (PORTABLE_V1; was legacy_root/software/oncovi on the development host).
    oncovi_dir         = '/opt/oncovi'
    // ---- Dashboard GeneBe annotation (default on) --------------------
    // GeneBe (https://genebe.net) adds ACMG classification, ClinVar
    // status, and gnomAD frequencies to the dashboard's Variants tab.
    // On by default. GeneBe works anonymously (rate-limited); for higher
    // limits, set genebe_user / genebe_key via the credentials.config
    // file loaded at the bottom of this file (NOT here, so the key never
    // lands in version control). To disable, set genebe_enabled = false.
    genebe_enabled = true
    genebe_user    = null
    genebe_key     = null

    // ---- Dashboard MobiDetails annotation (default on) ---------------
    // MobiDetails (https://mobidetails.chu-montpellier.fr) adds a curated
    // clinical annotation block (ClinVar, gnomAD v4, REVEL, AlphaMissense,
    // CADD, SpliceAI, MPA, etc.) to each variant's detail panel. Keyless
    // academic API; no credentials required. To disable, set
    // mobidetails_enabled = false.
    mobidetails_enabled = true

    // ---- Dashboard OncoKB annotation (opt-in) ------------------------
    // OncoKB (https://www.oncokb.org) provides precision-oncology
    // annotations for clinical variants. Free academic tokens are
    // available at https://www.oncokb.org/account/register.
    // Set oncokb_enabled = true and provide the token via the
    // credentials.config file (NOT here).
    oncokb_enabled = false
    oncokb_token   = null

    dashboard_python   = null

    // ---- Pipeline behaviour --------------------------------------------
    flt3_container     = 'docker'   // 'docker' or 'singularity'
    flt3_region        = 'chr13:28003000-28101000'  // hg38 FLT3 transcript + flanking (D1)

    // ---- Resources ------------------------------------------------------
    max_memory         = '128.GB'
    max_cpus           = 16
    max_time           = '240.h'

    // ---- nf-core conventions -------------------------------------------
    publish_dir_mode   = 'link'
    monochrome_logs    = false
    help               = false
    version            = false
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------
profiles {

    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled    = true
        docker.userEmulation = true
        singularity.enabled = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    conda {
        conda.enabled = true
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'normal'
    }

    // ---- Site profiles -------------------------------------------------
    // The two installations the pipeline was qualified on are kept here. A further server does
    // not need an entry: see the `site` profile below.

    gandalf {
        includeConfig 'conf/gandalf.config'
    }

    clinical23 {
        includeConfig 'conf/clinical23.config'
    }

    // MARKER PORTABLE_V1: a server's own profile without editing this file (which is part of the
    // tagged release and must stay unmodified in a release checkout). Copy conf/site_template.config
    // to conf/site.config -- git-ignored -- or anywhere else and name it in TSPIPE_SITE_CONFIG, fill
    // in its paths, and run with `-profile site,singularity`. The selection is made here, when the
    // configuration is read, so the profile behaves exactly like a named one (it is applied before
    // conf/modules.config and before any -c overlay).
    site {
        includeConfig( System.getenv('TSPIPE_SITE_CONFIG') ?: "${projectDir}/conf/site.config" )
        includeConfig 'conf/containers.config'   // images and in-image tool paths; last, as in the two named site profiles
    }
}

// ---------------------------------------------------------------------------
// Process resource defaults + per-module overrides
// ---------------------------------------------------------------------------
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// MARKER HARDEN_Q4_V1: every task shell runs with pipefail (audit Q4; previously set in 8 of 75
// module scripts only), so a failing producer in a pipe fails the task instead of being masked
// by the consumer's exit status. Module scripts that legitimately tolerate a failing producer
// carry an explicit `|| true` (reconcnv, bpt_*, cnvkit_pon_build, somaticseq).
process.shell = ['/bin/bash', '-euo', 'pipefail']

// ---------------------------------------------------------------------------
// Reporting
// ---------------------------------------------------------------------------
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
    overwrite = true
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.svg"
    overwrite = true
}

manifest {
    name            = 'nf-core-tspipe'
    homePage        = 'https://github.com/patkarlab/nf-core-tspipe'
    description     = 'Targeted sequencing pipeline for leukemia / myeloid panels'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.10.4'
    version         = '1.0.0'
}

// ---- GeneBe credentials (untracked) -------------------------------
// Loads ~/.config/nf-core-tspipe/credentials.config when present,
// overriding the genebe_enabled / genebe_user / genebe_key params
// declared in the params { ... } block above. The credentials file
// is git-ignored and intended to live in the user's home dir at
// mode 0600.
if (new File("${System.getProperty('user.home')}/.config/nf-core-tspipe/credentials.config").exists()) {
    includeConfig "${System.getProperty('user.home')}/.config/nf-core-tspipe/credentials.config"
}
